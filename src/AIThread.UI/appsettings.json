{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    },
    "Debug": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=AIThread;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "AIThread": {
    "ShortMemoryHours": 24,
    "MemoryConsolidationIntervalMinutes": 10,
    "MemoryRelabelIntervalMinutes": 10,
    "MemoryAcronyms": [],
    "RouterMonitorIntervalSeconds": 15,
    "ActivityLogRetentionDays": 14,
    "ExecutorFullFileMaxLines": 400,
    "Telegram": {
      "ApiBaseUrl": "https://api.telegram.org",
      "PollTimeoutSeconds": 50
    },
    "EmbeddedRedis": {
      "Enabled": true,
      "DataDirectory": "",
      "MemorySize": "16m",
      "CheckpointIntervalMinutes": 60
    },
    "NineRouter": {
      "AutoStart": true,
      "AutoInstall": false,
      "StopOnExit": false,
      "StartTimeoutSeconds": 90,
      "InstallTimeoutSeconds": 300,
      "NodePath": "",
      "CliPath": ""
    }
  }
}
