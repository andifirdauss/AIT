<?xml version="1.0" encoding="utf-8"?>
<!-- Standalone AIThread.exe for Windows: no .NET runtime needed on the target machine. Run scripts/publish-exe.ps1. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <AssemblyName>AIThread</AssemblyName>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\dist\AIThread\</PublishDir>
  </PropertyGroup>
</Project>
