@{
    ViewData["Title"] = Lang.T("Pengaturan", "Setting");
}

<div class="page-header">
    <div>
        <h1>@Lang.T("Pengaturan", "Setting")</h1>
        <p class="page-subtitle">@Lang.T("Koneksi 9router, perilaku proxy, build & verifikasi, penyimpanan memory & business memory, Telegram, serta keamanan & privasi.", "9router connection, proxy behaviour, build & verification, memory storage & business memory, Telegram, and security & privacy.")</p>
    </div>
</div>

@* Hidden: the sidebar submenu picks the tab (site.js initNavGroups); the buttons stay for the page scripts. *@
<ul class="nav nav-tabs d-none" id="settingTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="router-tab" data-bs-toggle="tab" data-bs-target="#tab-router" data-tab="router" type="button" role="tab" aria-controls="tab-router" aria-selected="true">@Lang.T("Koneksi 9router", "9router connection")</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="proxy-tab" data-bs-toggle="tab" data-bs-target="#tab-proxy" data-tab="proxy" type="button" role="tab" aria-controls="tab-proxy" aria-selected="false">@Lang.T("Proxy & orkestrasi", "Proxy & orchestration")</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="build-tab" data-bs-toggle="tab" data-bs-target="#tab-build" data-tab="build" type="button" role="tab" aria-controls="tab-build" aria-selected="false">@Lang.T("Build & verifikasi", "Build & verification")</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="memory-tab" data-bs-toggle="tab" data-bs-target="#tab-memory" data-tab="memory" type="button" role="tab" aria-controls="tab-memory" aria-selected="false">@Lang.T("Penyimpanan memory", "Memory storage")</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="telegram-tab" data-bs-toggle="tab" data-bs-target="#tab-telegram" data-tab="telegram" type="button" role="tab" aria-controls="tab-telegram" aria-selected="false">Telegram</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="keamanan-tab" data-bs-toggle="tab" data-bs-target="#tab-keamanan" data-tab="keamanan" type="button" role="tab" aria-controls="tab-keamanan" aria-selected="false">@Html.Raw(Lang.T("Keamanan &amp; privasi", "Security &amp; privacy"))</button>
    </li>
</ul>

@* One form spans the first three tabs so "Simpan" saves all of them; the Telegram tab has its own form. *@
<form id="settingForm" class="tab-content" autocomplete="off" novalidate>
    <div class="tab-pane active setting-pane" id="tab-router" role="tabpanel" aria-labelledby="router-tab" tabindex="0">
        <div class="card">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label small" for="routerUrl">Base URL</label>
                    <input type="url" class="form-control mono" id="routerUrl" placeholder="http://localhost:20128" required />
                    <div class="form-text">@Html.Raw(Lang.T("Endpoint 9router (dashboard default di port 20128). Akhiran <span class=\"mono\">/v1</span> otomatis dibuang.", "The 9router endpoint (default dashboard on port 20128). A trailing <span class=\"mono\">/v1</span> is dropped automatically."))</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small" for="routerKey">API key</label>
                    <input type="password" class="form-control mono" id="routerKey" placeholder="@Lang.T("Kosongkan untuk mempertahankan key tersimpan", "Leave empty to keep the stored key")" />
                    <div class="form-text" id="routerKeyHint"></div>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="routerKeyClear" />
                    <label class="form-check-label small" for="routerKeyClear">@Lang.T("Hapus API key tersimpan", "Delete the stored API key")</label>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnTestRouter">@Lang.T("Test koneksi", "Test connection")</button>
                    <span class="small" id="routerTestResult"></span>
                </div>
                <div class="form-text">@Html.Raw(Lang.T("Test koneksi memakai isi form tanpa menyimpannya. Klik <strong>Simpan pengaturan</strong> agar key dipakai AIT.", "Test connection uses the form without saving it. Click <strong>Save settings</strong> so AIT uses the key."))</div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">@Lang.T("Simpan pengaturan", "Save settings")</button>
            </div>
        </div>
    </div>

    <div class="tab-pane setting-pane" id="tab-proxy" role="tabpanel" aria-labelledby="proxy-tab" tabindex="0">
        <div class="card">
            <div class="card-body">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="orchestrationEnabled" />
                    <label class="form-check-label" for="orchestrationEnabled">@Lang.T("Orkestrasi aktif (planner → executor → wrapper)", "Orchestration on (planner → executor → wrapper)")</label>
                    <div class="form-text">@Lang.T("Jika mati, AIT hanya meneruskan request CLI ke 9router.", "When off, AIT only forwards CLI requests to 9router.")</div>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="streamProgress" />
                    <label class="form-check-label" for="streamProgress">@Lang.T("Tampilkan progres (rencana, tugas, tool planner) di CLI", "Show progress (plan, tasks, planner tools) in the CLI")</label>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="plannerCanAsk" />
                    <label class="form-check-label" for="plannerCanAsk">@Lang.T("Planner boleh bertanya bila permintaan ambigu", "The planner may ask when a request is ambiguous")</label>
                    <div class="form-text">
                        @Lang.T("Hanya untuk ambiguitas nyata, perubahan berisiko yang tidak diminta, atau fakta yang tidak ada di kode — bukan konfirmasi tiap prompt. Thread berhenti dengan pertanyaan bernomor; pesan berikutnya di sesi yang sama menjadi jawaban dan rencana dilanjutkan.", "Only for real ambiguity, risky changes nobody asked for, or facts that are not in the code — not to confirm every prompt. The thread stops with a numbered question; the next message in the same session becomes the answer and the plan goes on.")
                    </div>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="commandToolEnabled" />
                    <label class="form-check-label" for="commandToolEnabled">@Lang.T("Planner boleh menjalankan perintah (run_command)", "The planner may run commands (run_command)")</label>
                    <div class="form-text">
                        @Lang.T("Perintah baca saja (curl GET/HEAD ke localhost, git baca, cek versi) langsung jalan. curl ke host luar dan perintah lain menunggu izin developer: sekali atau selalu.", "Read-only commands (curl GET/HEAD to localhost, git reads, version checks) run at once. curl to outside hosts and any other command wait for the developer's permission: once or always.")
                    </div>
                </div>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" id="webFetchEnabled" />
                    <label class="form-check-label" for="webFetchEnabled">@Lang.T("Planner boleh membaca halaman web & API (web_fetch)", "The planner may read web pages & APIs (web_fetch)")</label>
                    <div class="form-text">
                        @Lang.T("Hanya HTTP GET, untuk dokumentasi library/API atau melihat response endpoint. localhost langsung jalan; host luar menunggu izin developer per host (izin yang sama dengan curl).", "HTTP GET only, for library/API documentation or to see an endpoint's response. localhost runs at once; outside hosts wait for the developer's permission per host (the same permission as curl).")
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-sm-6">
                        <label class="form-label small" for="commandTimeout">@Lang.T("Batas waktu perintah (detik)", "Command timeout (seconds)")</label>
                        <input type="number" class="form-control" id="commandTimeout" min="5" max="600" required />
                    </div>
                </div>
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="gitPublishEnabled" />
                    <label class="form-check-label" for="gitPublishEnabled">@Lang.T("AIT boleh commit & push bila diminta", "AIT may commit & push when asked")</label>
                    <div class="form-text">
                        @Lang.T("Hanya file yang ditulis thread, setelah perubahan terverifikasi, dan dengan izin developer. Tanpa --force; push ke main/master/release selalu ditanyakan.", "Only the files the thread wrote, after the change is verified, and with the developer's permission. Never --force; a push to main/master/release is always asked.")
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small" for="passthroughModel">Model passthrough</label>
                    <select class="form-select" id="passthroughModel"></select>
                    <div class="form-text">@Lang.T("Untuk request pendukung CLI (judul sesi, compact, dsb.) yang tidak diorkestrasi.", "For CLI support requests (session titles, compact, etc.) that are not orchestrated.")</div>
                </div>

                <div class="mb-3">
                    <label class="form-label small" for="proxyKey">Proxy API key (ANTHROPIC_AUTH_TOKEN / ANTHROPIC_API_KEY)</label>
                    <div class="input-group">
                        <input type="text" class="form-control mono" id="proxyKey" placeholder="@Lang.T("Kosong = terima semua request lokal", "Empty = accept every local request")" />
                        <button type="button" class="btn btn-outline-secondary" id="btnGenerateKey">Generate</button>
                    </div>
                    <div class="form-text">
                        @Lang.T("Integrasi CLI (Claude Code, Codex, Gemini CLI, opencode, Qwen Code, oh-my-pi) dan hook Context Keeper diatur di menu", "CLI integrations (Claude Code, Codex, Gemini CLI, opencode, Qwen Code, oh-my-pi) and the Context Keeper hook are set in the menu") <a asp-controller="Cli" asp-action="Index">CLI</a>@Lang.T(". Setelah key diganti, matikan lalu nyalakan lagi integrasinya di sana agar key baru tertulis.", ". After the key changes, turn the integration off and on again there so the new key is written.")
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="plannerMaxSteps">@Lang.T("Langkah planner", "Planner steps")</label>
                        <input type="number" class="form-control" id="plannerMaxSteps" min="3" max="100" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="executorMaxRetries">@Lang.T("Retry executor", "Executor retries")</label>
                        <input type="number" class="form-control" id="executorMaxRetries" min="0" max="5" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="maxParallelTasks">@Lang.T("Maks paralel", "Max parallel")</label>
                        <input type="number" class="form-control" id="maxParallelTasks" min="1" max="64" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="requestTimeout">@Lang.T("Timeout (detik)", "Timeout (seconds)")</label>
                        <input type="number" class="form-control" id="requestTimeout" min="30" max="3600" required />
                    </div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">@Lang.T("Simpan pengaturan", "Save settings")</button>
            </div>
        </div>
    </div>

    <div class="tab-pane setting-pane" id="tab-build" role="tabpanel" aria-labelledby="build-tab" tabindex="0">
        <div class="card">
            <div class="card-body">
                <div class="form-check form-switch mb-3">
                    <input class="form-check-input" type="checkbox" id="buildEnabled" />
                    <label class="form-check-label" for="buildEnabled">@Lang.T("Build & verifikasi otomatis", "Automatic build & verification")</label>
                    <div class="form-text">
                        @Html.Raw(Lang.T("AIT menjalankan perintah build bawaan project (<span class=\"mono\">dotnet build</span>, <span class=\"mono\">tsc</span>/<span class=\"mono\">npm run build</span>, <span class=\"mono\">go build</span>, <span class=\"mono\">cargo check</span>, <span class=\"mono\">mvn compile</span>): sebagai tool planner dan setelah executor selesai. Error build (dan temuan node Reviewer, bila ada) diserahkan ke executor sebagai tugas perbaikan.", "AIT runs the project's own build command (<span class=\"mono\">dotnet build</span>, <span class=\"mono\">tsc</span>/<span class=\"mono\">npm run build</span>, <span class=\"mono\">go build</span>, <span class=\"mono\">cargo check</span>, <span class=\"mono\">mvn compile</span>): as a planner tool and after the executors finish. Build errors (and the findings of the Reviewer node, when there is one) go to the executors as fix tasks."))
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="buildTimeout">@Lang.T("Timeout build (detik)", "Build timeout (seconds)")</label>
                        <input type="number" class="form-control" id="buildTimeout" min="30" max="3600" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small" for="maxFixRounds">@Lang.T("Putaran perbaikan", "Fix rounds")</label>
                        <input type="number" class="form-control" id="maxFixRounds" min="0" max="5" required />
                    </div>
                    <div class="col-md-6 form-text align-self-end">@Lang.T("0 = hanya verifikasi dan laporkan, tanpa perbaikan otomatis.", "0 = verify and report only, no automatic fixes.")</div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">@Lang.T("Simpan pengaturan", "Save settings")</button>
            </div>
        </div>
    </div>
</form>

<div class="tab-content">
    <div class="tab-pane" id="tab-memory" role="tabpanel" aria-labelledby="memory-tab" tabindex="0">
        <form id="memoryStorageForm" autocomplete="off" novalidate>
            <div class="row g-3 mb-3">
                <partial name="_MemoryStoreCard" model='("stm", "Short memory", "Memory baru dari tiap thread. Dipindah ke long memory setelah jendela short memory (default 24 jam) lewat.", true)' />
                <partial name="_MemoryStoreCard" model='("ltm", "Long memory", "Memory permanen hasil konsolidasi short memory. Dibaca planner di setiap thread. Arahkan semua developer ke database yang sama agar memory project terkumpul di satu tempat.", false)' />
                <partial name="_MemoryStoreCard" model='("bzm", "Business memory (wiki bisnis)", "Halaman wiki bisnis per modul: requirement, aturan bisnis, status, validasi, dan screenshot. Arahkan semua developer ke database yang sama agar satu wiki dibangun dari pekerjaan semua orang.", false)' />
            </div>
            <div class="card">
                <div class="card-body">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="memoryCopyExisting" checked />
                        <label class="form-check-label" for="memoryCopyExisting">@Lang.T("Salin memory yang ada ke penyimpanan baru saat provider/server diganti", "Copy the existing memory to the new storage when the provider/server changes")</label>
                    </div>
                    <div class="form-text">
                        @Html.Raw(Lang.T("Saat disimpan, AIT menguji koneksi dan membuat database/tabel <span class=\"mono\">ShortMemories</span>, <span class=\"mono\">LongMemories</span>, atau <span class=\"mono\">BusinessPages</span> (beserta revisi & gambarnya) bila belum ada (user perlu hak membuat tabel). Penyimpanan lama tidak dihapus atau diubah. Tanpa salinan, memory lama tidak terlihat sampai provider dikembalikan. Password disimpan terenkripsi dan tidak pernah dikirim balik ke browser. Memory dibagi antar developer berdasarkan <a href=\"/Project\">project key</a> (git remote, <span class=\"mono\">.aithread/project.json</span>, atau key manual), bukan folder root.", "When saving, AIT tests the connection and creates the database/tables <span class=\"mono\">ShortMemories</span>, <span class=\"mono\">LongMemories</span> or <span class=\"mono\">BusinessPages</span> (with their revisions & images) when missing (the user needs the right to create tables). The old storage is not deleted or changed. Without a copy, the old memory is not visible until the provider is switched back. Passwords are stored encrypted and never sent back to the browser. Memory is shared between developers by <a href=\"/Project\">project key</a> (git remote, <span class=\"mono\">.aithread/project.json</span>, or a manual key), not by root folder."))
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary" id="btnSaveMemoryStorage">@Lang.T("Simpan penyimpanan memory", "Save memory storage")</button>
                </div>
            </div>
        </form>
    </div>

    <div class="tab-pane" id="tab-telegram" role="tabpanel" aria-labelledby="telegram-tab" tabindex="0">
        <div class="card" id="telegramCard">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                @Html.Raw(Lang.T("<span>Telegram — prompt jarak jauh</span> <span class=\"ms-auto small\" id=\"telegramState\"></span>", "<span>Telegram — remote prompts</span> <span class=\"ms-auto small\" id=\"telegramState\"></span>"))
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <form id="telegramForm" autocomplete="off">
                            <p class="small text-secondary">
                                @Lang.T("Kirim prompt ke AIT dari HP lewat bot Telegram pribadi, misalnya saat laptop ditinggal di kantor/rumah. AIT menarik pesan dari Telegram (long polling), jadi tidak perlu URL publik atau membuka port — cukup laptop menyala dan terhubung internet.", "Send prompts to AIT from your phone through a private Telegram bot, e.g. while the laptop stays at the office/home. AIT pulls messages from Telegram (long polling), so no public URL or open port is needed — just a laptop that is on and online.")
                            </p>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="telegramEnabled" />
                                <label class="form-check-label" for="telegramEnabled">@Lang.T("Aktifkan bot Telegram", "Turn on the Telegram bot")</label>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small" for="telegramToken">Bot token</label>
                                <input type="password" class="form-control mono" id="telegramToken" placeholder="@Lang.T("Kosongkan untuk mempertahankan token tersimpan", "Leave empty to keep the stored token")" />
                                <div class="form-text" id="telegramTokenHint"></div>
                            </div>
                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" id="telegramTokenClear" />
                                <label class="form-check-label small" for="telegramTokenClear">@Lang.T("Hapus token tersimpan", "Delete the stored token")</label>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm">@Lang.T("Simpan Telegram", "Save Telegram")</button>
                            <ol class="small text-secondary mt-3 mb-0 ps-3">
                                <li>@Html.Raw(Lang.T("Di Telegram, chat <span class=\"mono\">@BotFather</span> → <span class=\"mono\">/newbot</span> → salin token.", "In Telegram, chat with <span class=\"mono\">@BotFather</span> → <span class=\"mono\">/newbot</span> → copy the token."))</li>
                                <li>@Html.Raw(Lang.T("Tempel token di atas, aktifkan, lalu klik <strong>Simpan Telegram</strong>.", "Paste the token above, turn it on, then click <strong>Save Telegram</strong>."))</li>
                                <li>@Html.Raw(Lang.T("Kirim <span class=\"mono\">/start</span> ke bot Anda, lalu klik <strong>Izinkan</strong> pada chat Anda di tabel.", "Send <span class=\"mono\">/start</span> to your bot, then click <strong>Allow</strong> on your chat in the table."))</li>
                                <li>@Html.Raw(Lang.T("Pilih project dengan <span class=\"mono\">/projects</span>, lalu kirim prompt seperti biasa.", "Choose a project with <span class=\"mono\">/projects</span>, then send prompts as usual."))</li>
                            </ol>
                        </form>
                    </div>
                    <div class="col-lg-7">
                        <label class="form-label small">Chat</label>
                        <div class="table-responsive">
                            <table class="table align-middle mb-2">
                                <thead>
                                    <tr class="text-nowrap"><th>Chat</th><th>Status</th><th>@Lang.T("Project aktif", "Active project")</th><th>@Lang.T("Pesan terakhir", "Last message")</th><th></th></tr>
                                </thead>
                                <tbody id="telegramChatRows">
                                    <tr><td colspan="5" class="text-secondary small">@Lang.T("Memuat…", "Loading…")</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small mb-2 d-none" id="telegramChatPager"></div>
                        <div class="form-text">
                            @Html.Raw(Lang.T("Hanya chat pribadi yang <strong>diizinkan</strong> yang bisa menjalankan prompt — izinkan hanya akun Telegram Anda sendiri, karena prompt dapat mengubah file project di komputer ini. Chat lain yang mengirim pesan ke bot muncul di sini sebagai <em>menunggu izin</em>.", "Only <strong>allowed</strong> private chats can run prompts — allow only your own Telegram account, since prompts can change project files on this computer. Other chats that message the bot show up here as <em>waiting for approval</em>."))
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="tab-pane" id="tab-keamanan" role="tabpanel" aria-labelledby="keamanan-tab" tabindex="0">
        <form class="card" id="securityForm" autocomplete="off" novalidate>
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <span>@Lang.T("Penyamaran secret", "Secret masking")</span>
                <button type="button" class="btn btn-link btn-sm ms-auto p-0" id="btnSecurityExplain">@Lang.T("Apa yang dilakukan AIT? →", "What does AIT do? →")</button>
            </div>
            <div class="card-body">
                <p class="small text-secondary">
                    @Html.Raw(Lang.T("Password, API key, token, JWT, private key, dan password di connection string diganti placeholder <span class=\"mono\">{{AIT_SECRET:…}}</span> sebelum isi file, prompt, atau output tool dikirim ke model. Nilai aslinya hanya disimpan di memori AIT, lalu dipasang kembali saat AIT (atau Claude Code lewat hook) menulis ke file Anda. File kredensial seperti <span class=\"mono\">.pem</span>, <span class=\"mono\">.pfx</span>, kunci SSH, <span class=\"mono\">.npmrc</span>, dan <span class=\"mono\">/.aws</span> tidak pernah dibaca, apa pun pengaturan di halaman ini.", "Passwords, API keys, tokens, JWTs, private keys and passwords in connection strings are replaced by the placeholder <span class=\"mono\">{{AIT_SECRET:…}}</span> before file contents, prompts or tool output are sent to a model. The real values are kept only in AIT's memory, and put back when AIT (or Claude Code through the hook) writes to your files. Credential files such as <span class=\"mono\">.pem</span>, <span class=\"mono\">.pfx</span>, SSH keys, <span class=\"mono\">.npmrc</span> and <span class=\"mono\">/.aws</span> are never read, whatever the settings on this page."))
                </p>
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" id="secMasking" />
                    <label class="form-check-label" for="secMasking">@Lang.T("Samarkan secret sebelum dikirim ke model dan sebelum disimpan", "Mask secrets before they are sent to a model and before they are stored")</label>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="secPassthrough" />
                    <label class="form-check-label" for="secPassthrough">@Lang.T("Samarkan juga request passthrough (yang diteruskan apa adanya ke 9router)", "Also mask passthrough requests (forwarded as they are to 9router)")</label>
                </div>
                <div class="form-text mb-3">
                    @Html.Raw(Lang.T("Untuk Claude Code, pasang hook di menu <a href=\"/Cli\">CLI</a> agar placeholder dari request passthrough ditulis kembali sebagai nilai asli. CLI lain bisa menerima placeholder apa adanya; matikan opsi ini bila CLI tersebut sering mengedit file berisi secret.", "For Claude Code, install the hook in the <a href=\"/Cli\">CLI</a> menu so placeholders from passthrough requests are written back as the real values. Other CLIs may receive the placeholders as they are; turn this option off when such a CLI often edits files holding secrets."))
                </div>

                <div class="security-stats mb-3" id="securityStats"></div>

                <div class="small text-secondary">
                    @Html.Raw(Lang.T("Atur per project di <span class=\"mono\">.aithread/project.json</span>:", "Set per project in <span class=\"mono\">.aithread/project.json</span>:"))
                    <pre class="mono small mb-0 mt-1">{
  "secrets": {
    "deny":  ["config/production/**"],   // @Lang.T("file tambahan yang tidak boleh dibaca", "extra files that must not be read")
    "allow": ["tests/certs/test.pem"],   // @Lang.T("file kredensial yang boleh dibaca (fixture test)", "credential files that may be read (test fixtures)")
    "keys":  ["LicenseCode"]             // @Lang.T("nama pengaturan tambahan yang nilainya disamarkan", "extra setting names whose values are masked")
  }
}</pre>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">@Lang.T("Simpan pengaturan keamanan", "Save security settings")</button>
            </div>
        </form>

        <div class="card mt-3">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <span>@Lang.T("Secret yang terdeteksi", "Detected secrets")</span>
                <span class="badge text-bg-secondary" id="secretCount">0</span>
                <input type="search" class="form-control form-control-sm ms-auto" id="secretFilter" style="max-width: 220px"
                       placeholder="@Lang.T("Cari label…", "Search label…")" aria-label="@Lang.T("Cari label", "Search label")" />
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnSecretsRefresh">@Lang.T("Muat ulang", "Reload")</button>
            </div>
            <div class="card-body">
                <p class="small text-secondary mb-2">
                    @Html.Raw(Lang.T("Nilai yang disamarkan sejak AIT berjalan, beserta label tempat ia ditemukan (nama pengaturan atau jenis token). Bila yang tersamarkan ternyata bukan secret, misalnya nama class, nama file, atau kode, klik <strong>Bukan secret</strong>: nilai itu tidak disamarkan lagi di mesin ini. Yang disimpan hanya id placeholder dan cuplikannya, bukan nilai aslinya; placeholder yang sudah terkirim tetap bisa dipulihkan.",
                        "Values masked since AIT started, with the label of where they were found (the setting name or the kind of token). When a masked value turns out not to be a secret, for example a class name, a file name or code, click <strong>Not secret</strong>: that value is no longer masked on this machine. Only the placeholder id and its preview are stored, not the real value; placeholders already sent can still be restored."))
                </p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Lang.T("Label", "Label")</th>
                                <th>@Lang.T("Nilai", "Value")</th>
                                <th class="text-end">@Lang.T("Disamarkan", "Masked")</th>
                                <th>@Lang.T("Terakhir", "Last seen")</th>
                                <th class="text-end">@Lang.T("Aksi", "Action")</th>
                            </tr>
                        </thead>
                        <tbody id="secretRows"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/settings.js" asp-append-version="true"></script>
}
