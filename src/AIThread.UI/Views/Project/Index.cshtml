@{
    ViewData["Title"] = "Project";
}

<div class="page-header">
    <div>
        <h1>Project</h1>
        <p class="page-subtitle">@Html.Raw(Lang.T("Codebase yang dikenal AIT. Identitas unik = folder root project (berisi <span class=\"mono\">.git</span> atau file build seperti <span class=\"mono\">.sln</span>, <span class=\"mono\">pom.xml</span>, <span class=\"mono\">package.json</span>), sehingga banyak sesi dari project berbeda tidak saling tercampur.", "Codebases AIT knows. The unique identity = the project root folder (with <span class=\"mono\">.git</span> or a build file such as <span class=\"mono\">.sln</span>, <span class=\"mono\">pom.xml</span>, <span class=\"mono\">package.json</span>), so many sessions of different projects never get mixed up."))</p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <p class="small text-secondary mb-2">
            @Lang.T("Project terdaftar otomatis pada prompt pertama dari sesi yang dibuka di folder project (atau di dalamnya). Sesi di folder tanpa marker project", "A project is registered automatically on the first prompt of a session opened in the project folder (or inside it). Sessions in a folder without a project marker are") <strong>@Lang.T("diabaikan", "ignored by")</strong> @Lang.T("AIT — prompt-nya diteruskan langsung tanpa orkestrasi dan tanpa memory. Pengarahan CLI coding (Claude Code, Codex, Gemini CLI, …) ke proxy ini (per project atau global) diatur di menu", "AIT — their prompts are forwarded as they are, without orchestration and without memory. Pointing coding CLIs (Claude Code, Codex, Gemini CLI, …) to this proxy (per project or globally) is set in the menu") <a asp-controller="Cli" asp-action="Index">CLI</a>.
        </p>
        <label class="form-label small text-secondary" for="projectPath">@Lang.T("Daftarkan manual", "Register manually")</label>
        <div class="input-group">
            <input type="text" class="form-control mono" id="projectPath" placeholder="@Lang.T("D:\\Source\\MyApp (folder project)", "D:\\Source\\MyApp (project folder)")" />
            <button class="btn btn-outline-secondary" type="button" id="btnBrowse">@Lang.T("Telusuri…", "Browse…")</button>
            <button class="btn btn-primary" type="button" id="btnRegister">@Lang.T("Daftarkan", "Register")</button>
        </div>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-clickable">
            <thead>
                <tr><th>Project</th><th>Stack</th><th>Thread</th><th>@Lang.T("Sesi", "Sessions")</th><th>Memory</th><th>@Lang.T("Terakhir dipakai", "Last used")</th><th></th></tr>
            </thead>
            <tbody id="projectRows"><tr><td colspan="7" class="empty-state">@Lang.T("Memuat…", "Loading…")</td></tr></tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center small d-none" id="projectPager"></div>
</div>

<partial name="_ProjectBrowser" />

@section Scripts {
    <script src="~/js/project-browser.js" asp-append-version="true"></script>
    <script src="~/js/pages/projects.js" asp-append-version="true"></script>
}
