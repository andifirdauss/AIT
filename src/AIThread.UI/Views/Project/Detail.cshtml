@{
    ViewData["Title"] = "Detail project";
    var projectId = (Guid)ViewData["ProjectId"]!;
}

<div class="page-header">
    <div>
        <a asp-controller="Project" asp-action="Index" class="small text-decoration-none">← Project</a>
        <h1 class="mt-1" id="projectName">Memuat…</h1>
        <p class="page-subtitle mono mb-1" id="projectPath"></p>
        <div id="projectStacks"></div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" href="/Memory?projectId=@projectId">Lihat memory project</a>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Thread</div><div class="stat-value" id="statThreads">–</div></div></div></div>
    <div class="col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Sesi CLI</div><div class="stat-value" id="statSessions">–</div></div></div></div>
    <div class="col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Memory</div><div class="stat-value" id="statMemory">–</div></div></div></div>
    <div class="col-md-3"><div class="card stat-card h-100"><div class="card-body"><div class="stat-label">Terakhir dipakai</div><div class="stat-value fs-5" id="statLastSeen">–</div></div></div></div>
</div>

<div class="row g-3">
    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-header">Project key</div>
            <div class="card-body">
                <div class="mono fw-semibold text-break" id="projectKey">–</div>
                <div class="small text-secondary mb-2" id="projectKeySource"></div>
                <p class="small text-secondary mb-2">
                    Memory dibagi antar developer berdasarkan key ini, walau folder root tiap orang berbeda. Urutannya:
                    file <span class="mono">.aithread/project.json</span> (<span class="mono">{ "key": "eep" }</span>) di repository,
                    key manual di bawah, lalu git remote <span class="mono">origin</span>.
                </p>
                <label class="form-label small text-secondary" for="manualKey">Key manual</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control mono" id="manualKey" maxlength="300" placeholder="mis. eep" />
                    <button class="btn btn-outline-primary" type="button" id="btnSaveKey">Simpan</button>
                </div>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header">Solution &amp; file build</div>
            <ul class="list-group list-group-flush small mono" id="projectModules"><li class="list-group-item text-secondary">Memuat…</li></ul>
        </div>
        <div class="card">
            <div class="card-header">Sesi</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Sesi</th><th>Thread</th><th>Terakhir</th></tr></thead>
                    <tbody id="sessionRows"><tr><td colspan="3" class="text-secondary">–</td></tr></tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center small d-none" id="sessionPager"></div>
        </div>
    </div>
    <div class="col-xl-8">
        <div class="card mb-3">
            <div class="card-header">Thread project ini</div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-clickable">
                    <thead><tr><th>Waktu</th><th>Project</th><th>Prompt</th><th>Status</th><th>Tugas</th><th>Durasi</th><th>Speedup</th><th>Token</th></tr></thead>
                    <tbody id="threadRows"><tr><td colspan="8" class="empty-state">Memuat…</td></tr></tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center small d-none" id="threadPager"></div>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex flex-wrap align-items-center gap-2">
                <span class="me-auto">Peta kode</span>
                <input type="search" class="form-control form-control-sm w-auto" id="codeMapSearch" placeholder="Cari path…" aria-label="Cari path" />
                <select class="form-select form-select-sm w-auto" id="codeMapModule" aria-label="Filter modul"><option value="">Semua modul</option></select>
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnCodeMapAdd">Atur file</button>
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnCodeMapScan" title="Petakan semua file yang belum punya modul">Scan</button>
            </div>
            <div class="card-body small text-secondary border-bottom">
                Modul dan layer tiap file, diputuskan sekali lalu dipakai ulang. Koreksi manual tidak pernah ditimpa; planner juga bisa mengoreksi lewat prompt ("anggap UserBL modul Account").
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>File</th><th>Modul</th><th>Layer</th><th>Area</th><th>Sumber</th><th></th></tr></thead>
                    <tbody id="codeMapRows"><tr><td colspan="6" class="text-secondary">Memuat…</td></tr></tbody>
                </table>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center small d-none" id="codeMapPager"></div>
        </div>

        <div class="card">
            <div class="card-header">Riwayat gabung modul</div>
            <div class="list-group list-group-flush small" id="mergeRows"><div class="list-group-item text-secondary">Memuat…</div></div>
            <div class="card-footer d-flex justify-content-between align-items-center small d-none" id="mergePager"></div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <span class="me-auto">Modul</span>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnCheckModules" title="Cari modul yang sama tapi terpisah (beda tulisan, terjemahan, nama lain)">Cek modul ganda</button>
    </div>
    <div class="card-body small text-secondary border-bottom">
        Bagian pertama label memory dan modul wiki bisnis. Nama lain dan terjemahan (alias) diarahkan ke modul yang sama.
        Modul ganda dengan keyakinan tinggi digabung otomatis; yang ragu menunggu di <a href="/Memory#review">Memory → Perlu review</a>.
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Modul</th><th>Alias</th><th>Memory</th><th>File</th><th></th></tr></thead>
            <tbody id="moduleRows"><tr><td colspan="5" class="text-secondary">Memuat…</td></tr></tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center small d-none" id="modulePager"></div>
</div>

<div class="card mt-3" id="unitTestCard">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <span class="me-auto">Unit test <span class="small text-secondary fw-normal" id="unitTestCounts"></span></span>
        <input type="search" class="form-control form-control-sm w-auto" id="unitTestSearch" placeholder="Cari nomor, judul, file…" aria-label="Cari unit test" />
        <select class="form-select form-select-sm w-auto" id="unitTestStateFilter" aria-label="Filter status unit test">
            <option value="">Semua kecuali dihapus</option>
            <option value="Active">Aktif</option>
            <option value="Obsolete">Obsolete</option>
            <option value="Quarantined">Karantina</option>
            <option value="Removed">Dihapus</option>
            <option value="Failing">Gagal terakhir</option>
        </select>
        <select class="form-select form-select-sm w-auto" id="unitTestModuleFilter" aria-label="Filter modul unit test"><option value="">Semua modul</option></select>
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnUnitTestSettings">Setting</button>
        <button type="button" class="btn btn-outline-primary btn-sm" id="btnUnitTestScan" title="Cari test di kode, daftarkan yang baru, dan beri judul serta tujuan dengan model murah">Scan test</button>
        <button type="button" class="btn btn-primary btn-sm" id="btnUnitTestRunAll" title="Jalankan semua test aktif sekarang">Jalankan semua</button>
    </div>
    <div class="card-body small text-secondary border-bottom" id="unitTestInfo">Memuat…</div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>No</th><th>Test</th><th>Modul</th><th>Status</th><th>Hasil terakhir</th><th>Asal</th><th></th></tr></thead>
            <tbody id="unitTestRows"><tr><td colspan="7" class="text-secondary">Memuat…</td></tr></tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center small d-none" id="unitTestPager"></div>
</div>

<div class="card mt-3" id="testAccountCard">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <span class="me-auto">Akun uji <span class="small text-secondary fw-normal" id="testAccountCount"></span></span>
        <button type="button" class="btn btn-outline-primary btn-sm" id="btnTestAccountAdd">Tambah akun</button>
    </div>
    <div class="card-body small text-secondary border-bottom" id="testAccountInfo">
        Akun yang dipakai node Tester untuk berganti user saat testing (pengaju, atasan, approver per level, admin). Dibagi ke semua developer
        project lewat project key. Tidak ada password per akun: Tester login dengan <strong>password dev</strong> project di bawah.
        Pakai akun uji, bukan akun karyawan sungguhan.
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Username</th><th>Peran</th><th>Atribut</th><th>Catatan</th><th></th></tr></thead>
            <tbody id="testAccountRows"><tr><td colspan="5" class="text-secondary">Memuat…</td></tr></tbody>
        </table>
    </div>
    <div class="card-body border-top">
        <div class="row g-3">
            <div class="col-lg-5">
                <label class="form-label small fw-semibold" for="devPassword">Password dev</label>
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control mono" id="devPassword" maxlength="200" autocomplete="off" />
                    <button class="btn btn-outline-primary" type="button" id="btnSaveDevPassword">Simpan</button>
                </div>
                <div class="form-text" id="devPasswordHint"></div>
                <div class="form-text text-warning">Jangan isi password asli: nilai ini terlihat oleh semua developer project. Untuk password asli, balas
                    <span class="mono">login &lt;user&gt; &lt;password&gt;</span> di chat (tidak disimpan).</div>
            </div>
            <div class="col-lg-7">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="small fw-semibold me-auto">Login as / impersonate</span>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDetectImpersonation" title="Cari fitur login sebagai user lain di kode project">Deteksi</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnEditImpersonation">Ubah</button>
                </div>
                <div class="small" id="impersonationInfo">–</div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3" id="testScenarioCard">
    <div class="card-header d-flex flex-wrap align-items-center gap-2">
        <span class="me-auto">Skenario test <span class="small text-secondary fw-normal" id="testScenarioCount"></span></span>
        <label class="btn btn-outline-primary btn-sm mb-0" for="testScenarioFile" title="Unggah file skenario (.xlsx) yang sudah diisi">Unggah Excel</label>
        <input type="file" class="d-none" id="testScenarioFile" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
    </div>
    <div class="card-body small text-secondary border-bottom">
        Alur multi-langkah (submit → approve per level → …) yang dijalankan Tester langkah demi langkah dengan akun uji. Dibuat dari
        <em>test lanjutan</em> yang disarankan Tester (halaman thread → <strong>Buat skenario Excel</strong>, atau balas
        <span class="mono">buat skenario test lanjutan &lt;nomor&gt;</span> di chat). Isi file Excel-nya, unggah di sini atau simpan di
        <span class="mono">.aithread/testing/</span> lalu balas <span class="mono">jalankan skenario &lt;nama&gt;</span>.
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Skenario</th><th>Langkah</th><th>Peran</th><th>Hasil terakhir</th><th></th></tr></thead>
            <tbody id="testScenarioRows"><tr><td colspan="5" class="text-secondary">Memuat…</td></tr></tbody>
        </table>
    </div>
</div>

<div class="card win mt-3" id="structureWindow" data-win-id="project-structure" data-win-persist>
    <div class="card-header win-bar flex-wrap">
        <win-controls disabled="close" />
        <span class="win-title">Struktur kode</span>
        <div class="win-actions flex-wrap">
            <div class="btn-group btn-group-sm" role="group" aria-label="Tampilan struktur">
                <input type="radio" class="btn-check" name="structureView" id="structureViewFolder" value="folder" checked />
                <label class="btn btn-outline-secondary" for="structureViewFolder">Folder</label>
                <input type="radio" class="btn-check" name="structureView" id="structureViewClass" value="class" />
                <label class="btn btn-outline-secondary" for="structureViewClass">Class</label>
            </div>
            <input type="search" class="form-control form-control-sm structure-search" id="structureSearch" placeholder="Cari class, method, file…" aria-label="Cari di struktur kode" />
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnStructureRescan" title="Baca ulang file yang berubah sejak scan terakhir">Scan ulang</button>
        </div>
    </div>
    <div class="card-body small text-secondary border-bottom py-2" id="structureSummary">Memuat…</div>
    <div class="structure-tree" id="structureTree" role="tree" aria-label="Struktur kode"></div>
</div>

<div class="modal fade" id="moduleModal" tabindex="-1" aria-labelledby="moduleModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="moduleForm" autocomplete="off">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="moduleModalTitle">Modul</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="moduleName" />
                <div class="mb-2">
                    <label class="form-label small" for="moduleNewName">Nama</label>
                    <input type="text" class="form-control" id="moduleNewName" maxlength="100" required />
                    <div class="form-text">Singkatan ditulis kapital (<span class="mono">MKPP</span>, <span class="mono">KlaimDF</span>). Mengganti nama ikut mengubah memory, peta kode, dan halaman wiki modul ini; nama lama disimpan sebagai alias.</div>
                </div>
                <div class="mb-2">
                    <label class="form-label small" for="moduleDescription">Deskripsi</label>
                    <input type="text" class="form-control" id="moduleDescription" maxlength="500" placeholder="Satu baris: modul ini mencakup apa" />
                </div>
                <div class="mb-3">
                    <label class="form-label small" for="moduleAliases">Alias (dipisah koma)</label>
                    <input type="text" class="form-control" id="moduleAliases" placeholder="Pengguna, Users" />
                    <div class="form-text">Nama lain atau terjemahan. Memory, file, dan halaman wiki dengan nama ini masuk ke modul ini.</div>
                </div>
                <label class="form-label small" for="moduleMergeInto">Gabungkan ke modul lain</label>
                <div class="input-group input-group-sm">
                    <select class="form-select" id="moduleMergeInto"></select>
                    <button type="button" class="btn btn-outline-danger" id="btnModuleMerge">Gabungkan</button>
                </div>
                <div class="form-text">Memory, peta kode, dan halaman wiki modul ini pindah ke modul tujuan. Bisa dibatalkan dari riwayat.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="submit" class="btn btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="codeMapModal" tabindex="-1" aria-labelledby="codeMapModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="codeMapForm" autocomplete="off">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="codeMapModalTitle">Atur modul file</h5>
            </div>
            <div class="modal-body">
                <div class="mb-2">
                    <label class="form-label small" for="codeMapPath">File atau nama class</label>
                    <input type="text" class="form-control mono" id="codeMapPath" placeholder="src/Bl/UserBL.cs atau UserBL" required />
                </div>
                <div class="row g-2">
                    <div class="col-7">
                        <label class="form-label small" for="codeMapModuleInput">Modul</label>
                        <input type="text" class="form-control" id="codeMapModuleInput" list="codeMapModuleList" maxlength="100" required />
                        <datalist id="codeMapModuleList"></datalist>
                    </div>
                    <div class="col-5">
                        <label class="form-label small" for="codeMapLayer">Layer</label>
                        <select class="form-select" id="codeMapLayer">
                            <option value="">(tetap)</option><option>UI</option><option>Entry</option><option>Logic</option><option>Data</option><option>Infra</option><option>Test</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="submit" class="btn btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="unitTestSettingsModal" tabindex="-1" aria-labelledby="unitTestSettingsTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="unitTestSettingsForm" autocomplete="off">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="unitTestSettingsTitle">Setting unit test</h5>
            </div>
            <div class="modal-body">
                <p class="small text-secondary">Berlaku untuk semua developer project ini (disimpan bersama katalog, mengikuti penyimpanan long memory).</p>
                <div class="mb-3">
                    <label class="form-label small" for="unitTestMode">Test yang dijalankan tiap thread</label>
                    <select class="form-select" id="unitTestMode">
                        <option value="Relevant">Relevan saja: test yang terkait file/modul yang diubah</option>
                        <option value="All">Semua test aktif</option>
                        <option value="Off">Mati</option>
                    </select>
                    <div class="form-text">Test dijalankan sebelum perubahan (baseline, paralel dengan planner) dan setelah build lolos. Hasil kode yang sama dipakai ulang tanpa menjalankan lagi.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label small" for="unitTestAuthoring">Buat unit test baru</label>
                    <select class="form-select" id="unitTestAuthoring">
                        <option value="OnRequest">Hanya saat diminta</option>
                        <option value="AutoLogic">Otomatis untuk perubahan logika bisnis (layer Logic)</option>
                        <option value="Off">Tidak pernah</option>
                    </select>
                </div>
                <div class="form-check form-switch mb-1">
                    <input class="form-check-input" type="checkbox" role="switch" id="unitTestKeepSnapshots" />
                    <label class="form-check-label" for="unitTestKeepSnapshots">Simpan snapshot test</label>
                </div>
                <div class="form-text mb-3">Isi file test disimpan di katalog agar test yang hilang dari repository developer lain bisa dipulihkan otomatis. Snapshot tidak pernah ditampilkan. Dimatikan: snapshot yang ada ikut dihapus.</div>
                <label class="form-label small" for="unitTestTimeout">Batas waktu run test (detik)</label>
                <input type="number" class="form-control" id="unitTestTimeout" min="10" max="3600" placeholder="Kosong = ikut batas waktu build" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="submit" class="btn btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="unitTestDetailModal" tabindex="-1" aria-labelledby="unitTestDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="unitTestDetailTitle">Unit test</h5>
            </div>
            <div class="modal-body" id="unitTestDetailBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="testAccountModal" tabindex="-1" aria-labelledby="testAccountModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="testAccountForm" autocomplete="off">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="testAccountModalTitle">Akun uji</h5>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="testAccountUsername">Username</label>
                        <input type="text" class="form-control mono" id="testAccountUsername" maxlength="200" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="testAccountRole">Peran</label>
                        <input type="text" class="form-control" id="testAccountRole" maxlength="100" list="testAccountRoleList" placeholder="mis. Pengaju, Atasan, HR, Administrator" />
                        <datalist id="testAccountRoleList"></datalist>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="d-flex align-items-center mb-1">
                        <span class="form-label mb-0 me-auto">Atribut</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnTestAccountAttribute">Tambah atribut</button>
                    </div>
                    <div class="form-text mb-2">Bebas per project, mis. NIK, Unit, Level approval, Atasan (username atasannya). Tester memakainya untuk memilih akun.</div>
                    <datalist id="testAccountKeyList"></datalist>
                    <div id="testAccountAttributes"></div>
                </div>
                <div class="mt-3">
                    <label class="form-label" for="testAccountNotes">Catatan</label>
                    <textarea class="form-control" id="testAccountNotes" rows="2" maxlength="1000" placeholder="mis. dipakai untuk flow cuti saja"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="submit" class="btn btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="impersonationModal" tabindex="-1" aria-labelledby="impersonationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="impersonationForm" autocomplete="off">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="impersonationModalTitle">Login as / impersonate</h5>
            </div>
            <div class="modal-body">
                <label class="form-label" for="impersonationStatus">Status</label>
                <select class="form-select" id="impersonationStatus">
                    <option value="available">Tersedia</option>
                    <option value="none">Tidak ada</option>
                    <option value="unknown">Belum diketahui</option>
                </select>
                <label class="form-label mt-3" for="impersonationHow">Cara memakai</label>
                <textarea class="form-control" id="impersonationHow" rows="2" maxlength="2000" placeholder="mis. Admin › Users › cari username › tombol Login as, atau GET /Account/LoginAs?username={{target}}"></textarea>
                <label class="form-label mt-3" for="impersonationBack">Cara kembali ke admin</label>
                <input type="text" class="form-control" id="impersonationBack" maxlength="1000" placeholder="mis. tombol Kembali ke admin di header (kosongkan bila tidak ada)" />
                <label class="form-label mt-3" for="impersonationRoles">Peran yang boleh memakai</label>
                <input type="text" class="form-control" id="impersonationRoles" maxlength="500" placeholder="pisahkan dengan koma, mis. Administrator, HR" />
                <div class="form-text">Dicocokkan dengan peran akun uji (tidak peka huruf besar/kecil).</div>
                <div class="form-check mt-3">
                    <input class="form-check-input" type="checkbox" id="impersonationConfirmed" />
                    <label class="form-check-label" for="impersonationConfirmed">Sudah saya cek, cara ini benar</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="submit" class="btn btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>window.projectId = '@projectId';</script>
    <script src="~/js/pages/project-detail.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-unittests.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-testaccounts.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-scenarios.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-structure.js" asp-append-version="true"></script>
}
