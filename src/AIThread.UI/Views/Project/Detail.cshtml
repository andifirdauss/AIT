    <script src="~/js/pages/project-unittests.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-testaccounts.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-scenarios.js" asp-append-version="true"></script>
    <script src="~/js/pages/project-structure.js" asp-append-version="true"></script>
}
