@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var appVersion = AIThread.UI.Hosting.Cli.Version;
    string Active(string name) =>string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="@Lang.Current" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIT</title>
    <script>
        // Apply the stored color mode before first paint to avoid a flash.
        (() => {
            try {
                const theme = localStorage.getItem('aithread-theme');
                if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-bs-theme', theme);
            } catch { }
        })();
    </script>
    <script type="importmap"></script>
    <link rel="icon" href="~/img/aithread.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIThread.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="app-brand" asp-controller="Home" asp-action="Index">
                <img class="app-brand-mark" src="~/img/aithread.svg" alt="" width="30" height="30" />
                <span>AIT</span>
            </a>
            <a id="npmUpdate" class="app-update d-none" href="https://www.npmjs.com/package/aithread" target="_blank" rel="noopener" data-version="@appVersion">
                @Html.Raw(Lang.T("<span class=\"app-update-dot\"></span> <span class=\"app-update-text\">Update tersedia</span>", "<span class=\"app-update-dot\"></span> <span class=\"app-update-text\">Update available</span>"))
            </a>
            @* Icons are one stroke SVG sprite so they share size and weight in every font (the old Unicode glyphs did not). *@
            <svg class="d-none" aria-hidden="true">
                <symbol id="nav-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></symbol>
                <symbol id="nav-project" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></symbol>
                <symbol id="nav-memory" viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="8" ry="2.5" /><path d="M4 5.5v6c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5v-6" /><path d="M4 11.5v6c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5v-6" /></symbol>
                <symbol id="nav-setup" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" /></symbol>
                <symbol id="nav-node" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="19" r="2.5" /><circle cx="19" cy="19" r="2.5" /><path d="M12 7.5v4m0 0L6.8 17m5.2-5.5 5.2 5.5" /></symbol>
                <symbol id="nav-skill" viewBox="0 0 24 24"><path d="M10 4a2 2 0 1 1 4 0v2h4a1 1 0 0 1 1 1v4h-2a2 2 0 1 0 0 4h2v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1v-4h2a2 2 0 1 0 0-4H5V7a1 1 0 0 1 1-1h4z" /></symbol>
                <symbol id="nav-cli" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3m6 0h4" /></symbol>
                <symbol id="nav-setting" viewBox="0 0 24 24"><path d="M4 6h10m4 0h2M4 12h4m4 0h8M4 18h12" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></symbol>
                <symbol id="nav-docs" viewBox="0 0 24 24"><path d="M3 5.5A1.5 1.5 0 0 1 4.5 4H9a3 3 0 0 1 3 3v13a2.5 2.5 0 0 0-2.5-2.5h-5A1.5 1.5 0 0 1 3 16z" /><path d="M21 5.5A1.5 1.5 0 0 0 19.5 4H15a3 3 0 0 0-3 3v13a2.5 2.5 0 0 1 2.5-2.5h5a1.5 1.5 0 0 0 1.5-1.5z" /></symbol>
                <symbol id="nav-guide" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.4M12 17h.01" /></symbol>
                <symbol id="nav-log" viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z" /><path d="M14 3v5h5M9 12h7M9 16h7M9 8h2" /></symbol>
                <symbol id="nav-shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z" /><path d="m9 12 2 2 4-4" /></symbol>
            </svg>
            <nav class="app-nav">
                <div class="app-nav-section">@Lang.T("Ruang kerja", "Workspace")</div>
                <a class="app-nav-link @Active("Home") @Active("Thread")" asp-controller="Home" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-dashboard" /></svg>@Lang.T("Dasbor", "Dashboard")</a>
                <a class="app-nav-link @Active("Project")" asp-controller="Project" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-project" /></svg>@Lang.T("Proyek", "Project")</a>
                <div class="app-nav-group" data-nav-group="memory">
                    <button type="button" class="app-nav-link @Active("Memory")" data-nav-toggle aria-expanded="false" aria-controls="nav-sub-memory"><svg class="app-nav-icon"><use href="#nav-memory" /></svg>@Lang.T("Memori", "Memory")<svg class="app-nav-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" /></svg></button>
                    <div class="app-nav-sub" id="nav-sub-memory">
                        <a class="app-nav-sublink" href="/Memory#" data-sub-tab="" title="@Lang.T("Termasuk bagian Perlu review", "Includes the Needs review part")">Short &amp; long memory<span class="badge text-bg-warning d-none" id="reviewBadge"></span></a>
                        <a class="app-nav-sublink" href="/Memory#bisnis" data-sub-tab="bisnis">Business memory</a>
                    </div>
                </div>

                <div class="app-nav-section">@Lang.T("Konfigurasi", "Configuration")</div>
                <a class="app-nav-link @Active("Setup")" asp-controller="Setup" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-setup" /></svg>@Lang.T("Penyiapan", "Setup")<span class="app-nav-badge d-none" id="setupBadge"></span></a>
                <a class="app-nav-link @Active("Node")" asp-controller="Node" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-node" /></svg>Node</a>
                <a class="app-nav-link @Active("Skill")" asp-controller="Skill" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-skill" /></svg>Skill</a>
                <a class="app-nav-link @Active("Cli")" asp-controller="Cli" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-cli" /></svg>CLI</a>
                <div class="app-nav-group" data-nav-group="setting">
                    <button type="button" class="app-nav-link @Active("Setting")" data-nav-toggle aria-expanded="false" aria-controls="nav-sub-setting"><svg class="app-nav-icon"><use href="#nav-setting" /></svg>@Lang.T("Pengaturan", "Setting")<svg class="app-nav-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" /></svg></button>
                    <div class="app-nav-sub" id="nav-sub-setting">
                        <a class="app-nav-sublink" href="/Setting#router" data-sub-tab="router">@Lang.T("Koneksi 9router", "9router connection")</a>
                        <a class="app-nav-sublink" href="/Setting#proxy" data-sub-tab="proxy">@Lang.T("Proxy & orkestrasi", "Proxy & orchestration")</a>
                        <a class="app-nav-sublink" href="/Setting#build" data-sub-tab="build">@Lang.T("Build & verifikasi", "Build & verification")</a>
                        <a class="app-nav-sublink" href="/Setting#memory" data-sub-tab="memory">@Lang.T("Penyimpanan memory", "Memory storage")</a>
                        <a class="app-nav-sublink" href="/Setting#telegram" data-sub-tab="telegram">Telegram</a>
                        <a class="app-nav-sublink" href="/Setting#keamanan" data-sub-tab="keamanan">@Lang.T("Keamanan & privasi", "Security & privacy")</a>
                    </div>
                </div>

                <div class="app-nav-section">@Lang.T("Bantuan", "Help")</div>
                <a class="app-nav-link @Active("Docs")" asp-controller="Docs" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-docs" /></svg>@Lang.T("Dokumentasi", "Docs")</a>
                <div class="app-nav-group" data-nav-group="log">
                    <button type="button" class="app-nav-link @Active("Log")" data-nav-toggle aria-expanded="false" aria-controls="nav-sub-log"><svg class="app-nav-icon"><use href="#nav-log" /></svg>@Lang.T("Log & diagnostik", "Log & diagnostics")<svg class="app-nav-chevron" viewBox="0 0 24 24"><path d="m9 6 6 6-6 6" /></svg></button>
                    <div class="app-nav-sub" id="nav-sub-log">
                        <a class="app-nav-sublink" href="/Log#incidents" data-sub-tab="incidents">@Lang.T("Insiden", "Incidents")<span class="badge text-bg-danger d-none" id="incidentBadge"></span></a>
                        <a class="app-nav-sublink" href="/Log#activity" data-sub-tab="activity">@Lang.T("Log aktivitas", "Activity log")</a>
                        <a class="app-nav-sublink" href="/Log#files" data-sub-tab="files">@Lang.T("File log", "Log files")</a>
                    </div>
                </div>
                <button type="button" class="app-nav-link" id="onboardingOpen"><svg class="app-nav-icon"><use href="#nav-guide" /></svg>@Lang.T("Panduan memulai", "Getting started")</button>
                <button type="button" class="app-nav-link" id="securityNoticeOpen"><svg class="app-nav-icon"><use href="#nav-shield" /></svg>@Lang.T("Keamanan & privasi", "Security & privacy")</button>
            </nav>
            <div class="app-sidebar-footer">
                <div id="routerPill" class="router-pill" title="@Lang.T("Status koneksi 9router", "9router connection status")">
                    <span class="status-dot"></span><span class="router-pill-text">9router…</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-sidebar w-100 mt-2" id="themeToggle">@Lang.T("Ganti tema", "Switch theme")</button>
                <select class="form-select form-select-sm btn-sidebar w-100 mt-2" id="languageSelect" aria-label="Bahasa / Language" title="Bahasa AIT: UI, output ke CLI, log / AIT language: UI, CLI output, logs">
                    <option value="id">🌐 Bahasa Indonesia</option>
                    <option value="en">🌐 English</option>
                </select>
            </div>
        </aside>
        <main class="app-main" role="main">
            @* The newest version's note, then the earlier ones, newest first. Only the newest shows; site.js (initUpdateBar)
               opens the rest, so the bar keeps its height however many versions there are. *@
            <div id="updateBar" class="alert alert-info win-dismissible fade show mb-4 d-none" role="alert" data-version="@appVersion">
                <win-controls for="alert" />
                <div class="update-notes">
                    <div class="update-note">
                        <strong>🚀 AIT @Lang.T("versi", "version") @appVersion</strong> — @Html.Raw(Lang.T(
                            "<strong>Planner dan eksekusi kini paralel</strong>: untuk perubahan besar, planner mengirim tugas yang sudah pasti per batch dan executor langsung mengerjakannya selagi planner menyusun sisanya. Planner melihat hasilnya dan bisa menambah tugas perbaikan (<strong>Eksekusi selama planning</strong> di Pengaturan). Panggilan model yang habis oleh Timeout tidak lagi diulang ke model yang sama, setiap langkah planner tercatat di log, dan pekerjaan latar belakang tidak lagi mengantrekan planner. <strong>Perubahan kecil kini jauh lebih cepat</strong>: nyalakan <strong>Planner baca langsung</strong> di node Planner agar planner membaca file sendiri tanpa menunggu tools node (uji 5 pasang perubahan kecil: planning dari 34 ke 14 detik). File kecil yang disebut prompt langsung masuk ke brief planner, build dan reviewer berjalan bersamaan, build verifikasi kini incremental, unit test tidak membuild ulang, dan perubahan kecil yang lolos semua pemeriksaan tidak menunggu Wrapper. Hasil ekstraksi memory tampil sebagai notifikasi di web dan desktop Windows (bisa dimatikan lewat <strong>Mode senyap</strong> di Pengaturan), dan autostart tidak lagi memunculkan jendela console. Menu Node punya tombol <strong>Benchmark</strong> untuk melihat node yang paling lambat. Node <code>cli:claude:…</code> juga lebih cepat: proses CLI disiapkan sebelum dipakai dan AIT tidak lagi menunggu CLI menutup diri.",
                            "<strong>Planning and execution now run in parallel</strong>: for larger changes the planner sends the tasks that are final in batches and the executors start on them while the planner plans the rest. The planner sees the results and can add fix tasks (<strong>Execute while planning</strong> in Settings). A model call that runs out of Timeout is no longer repeated on the same model, every planner step is logged, and background work no longer queues the planner. <strong>Small changes are now much faster</strong>: turn on <strong>Planner reads directly</strong> in the Planner node so the planner reads files itself without waiting for the tools node (test of 5 pairs of small changes: planning went from 34 to 14 seconds). Small files the prompt names go straight into the planner brief, the build and the reviewer run together, the verification build is now incremental, unit tests do not build again, and a small change that passed every check does not wait for the Wrapper. The memory extraction result shows as a notification on the web and the Windows desktop (turn it off with <strong>Silent mode</strong> in Settings), and autostart no longer opens a console window. The Node menu has a <strong>Benchmark</strong> button to see which node is slowest. <code>cli:claude:…</code> nodes are faster too: the CLI process is started ahead of use and AIT no longer waits for the CLI to shut down."))
                        <a href="@Lang.T("/Docs/07-cara-kerja#eksekusi-selama-planning", "/Docs/07-cara-kerja#execution-while-planning")" class="alert-link ms-2">@Lang.T("Eksekusi selama planning →", "Execute while planning →")</a>
                        <a href="@Lang.T("/Docs/02-konfigurasi#tools-node-planner", "/Docs/02-konfigurasi#planner-tools-node")" class="alert-link ms-2">@Lang.T("Planner baca langsung →", "Planner reads directly →")</a>
                    </div>
                    <div class="update-more" id="updateMore" hidden>
                        <div class="update-note">
                            @Html.Raw(Lang.T("<strong>🚀 AIT versi 1.18.1</strong> — <strong>AI bawaan CLI kini memakai AIT dengan sendirinya</strong>: pasang satu perintah <code>npx -y aithread skill install all</code> (Codex, Gemini CLI, opencode, Qwen Code, oh-my-pi) atau plugin Claude Code, lalu setiap prompt yang mengubah kode didelegasikan ke AIT, sedangkan tanya jawab tetap dijawab AI bawaan. Bila AIT belum terpasang, AI meminta konfirmasi sekali lalu memasang dan menyetelnya. Hook menolak edit file langsung di project yang siap, dan <code>aithread skill off</code> mematikannya per project. Ada perintah baru untuk agen AI: <code>doctor</code>, <code>setup auto</code>, <code>project add</code>, <code>thread wait</code>. Paket aplikasinya juga lebih kecil. <a href=\"/Docs/03-integrasi-cli#plugin-claude-code-ait-sebagai-skill\" class=\"alert-link ms-2\">Plugin AIT →</a>", "<strong>🚀 AIT version 1.18.1</strong> — <strong>Your CLI's built-in AI now uses AIT on its own</strong>: run <code>npx -y aithread skill install all</code> (Codex, Gemini CLI, opencode, Qwen Code, oh-my-pi) or add the Claude Code plugin, and every prompt that changes code is delegated to AIT, while questions are still answered by the built-in AI. When AIT is not installed, the AI asks for confirmation once, then installs and sets it up. A hook refuses direct file edits in a ready project, and <code>aithread skill off</code> turns that off per project. New commands for AI agents: <code>doctor</code>, <code>setup auto</code>, <code>project add</code>, <code>thread wait</code>. The app package is smaller too. <a href=\"/Docs/03-integrasi-cli#claude-code-plugin-ait-as-a-skill\" class=\"alert-link ms-2\">AIT plugin →</a>"))
                        </div>
                        <div class="update-note">
                            @Html.Raw(Lang.T("<strong>🚀 AIT versi 1.17.0</strong> — <strong>Memory ikut tahu perubahan yang dibuat di luar AIT</strong>: ingest commit kini juga membaca commit di branch yang sedang di-checkout, jadi perubahan lewat CLI atau provider lain masuk memory sebelum di-merge. Rebase, amend, cherry-pick, dan squash merge dikenali (<code>git patch-id</code> + blob), jadi tidak dirangkum dua kali. Branch yang dibuang tanpa merge membuat memory-nya dilewati planner. Planner juga melihat daftar file yang belum di-commit dan bukan tulisan AIT (path + jumlah baris saja, tanpa model). Selama ingest mati, kartu <strong>Git</strong> di Project → Detail menghitung commit 30 hari yang belum dikenal memory dan menawarkan <strong>Nyalakan &amp; rangkum</strong>. Pembacaan branch kerja bisa dimatikan per project. <a href=\"/Docs/07-cara-kerja#commit-di-luar-ait\" class=\"alert-link ms-2\">Commit di luar AIT →</a>", "<strong>🚀 AIT version 1.17.0</strong> — <strong>Memory now knows about changes made outside AIT</strong>: commit ingest also reads the commits on the checked-out branch, so changes made through another CLI or provider reach memory before they are merged. Rebase, amend, cherry-pick and squash merge are recognised (<code>git patch-id</code> + blobs), so nothing is summarized twice. A branch dropped without a merge makes the planner skip its memory. The planner also sees the uncommitted files AIT did not write (path and line counts only, no model). While ingest is off, the <strong>Git</strong> card in Project → Detail counts the last 30 days of commits memory does not know and offers <strong>Turn on &amp; summarize</strong>. Reading the working branch can be turned off per project. <a href=\"/Docs/07-cara-kerja#commits-made-outside-ait\" class=\"alert-link ms-2\">Commits outside AIT →</a>"))
                        </div>
                        <div class="update-note">
                            @Html.Raw(Lang.T("<strong>🚀 AIT versi 1.16.0</strong> — <strong>Mesin model CLI kini juga Codex, Gemini CLI, dan Antigravity</strong>: selain <code>cli:claude:…</code>, node bisa memakai <code>cli:codex</code>, <code>cli:gemini:pro</code>/<code>flash</code>, atau <code>cli:agy:&lt;model&gt;</code>. Model Antigravity diambil langsung dari <code>agy models</code> akun Google itu (Gemini, Claude, GPT-OSS). Seperti Claude Code, CLI berjalan dengan login yang sudah ada di komputer itu, tanpa tool bawaan, dengan system prompt dari AIT, di folder kosong. Orkestrasi dan penulisan file tetap milik AIT. CLI yang diarahkan ke AIT tidak muter balik: base URL loopback dibuang, <code>config.toml</code> Codex yang default ke profile <code>aithread</code> dilewati, dan <code>.gemini/.env</code> yang menunjuk AIT diganti endpoint resmi Google. Percakapan yang disimpan agy untuk panggilan AIT dihapus setelah tiap panggilan. Gambar belum bisa lewat Gemini CLI dan agy (model diberi catatan). <a href=\"/Docs/03-integrasi-cli#cli-resmi-sebagai-mesin-model-tanpa-9router\" class=\"alert-link ms-2\">CLI sebagai mesin model →</a>", "<strong>🚀 AIT version 1.16.0</strong> — <strong>The CLI model engine now also covers Codex, Gemini CLI and Antigravity</strong>: besides <code>cli:claude:…</code>, a node can use <code>cli:codex</code>, <code>cli:gemini:pro</code>/<code>flash</code> or <code>cli:agy:&lt;model&gt;</code>. Antigravity's models come straight from <code>agy models</code> for that Google account (Gemini, Claude, GPT-OSS). Like Claude Code, the CLI runs with the login already on that computer, without its built-in tools, with AIT's system prompt, in an empty folder. Orchestration and file writes stay with AIT. A CLI pointed at AIT does not loop back: loopback base URLs are dropped, a Codex <code>config.toml</code> defaulting to the <code>aithread</code> profile is skipped, and a <code>.gemini/.env</code> pointing at AIT is replaced by Google's official endpoint. The conversations agy saves for AIT's calls are deleted after each call. Images cannot go through Gemini CLI and agy yet (the model gets a note). <a href=\"/Docs/03-integrasi-cli#official-cli-as-the-model-engine-no-9router\" class=\"alert-link ms-2\">CLI as model engine →</a>"))
                        </div>
                        <div class="update-note">
                            @Html.Raw(Lang.T("<strong>🚀 AIT versi 1.15.0</strong> — <strong>Planner bisa membaca dan mengubah database project</strong>: kartu <strong>Database</strong> di Project → Detail menyimpan koneksi SQL Server, PostgreSQL, MySQL, Oracle, atau SQLite di mesin ini saja (password dienkripsi), dengan environment Dev/Staging/Prod. Planner dan Tester membaca lewat <code>query_database</code> di transaksi baca-saja yang selalu di-rollback, dan kolom sensitif sampai ke model sebagai placeholder. Perubahan data (<code>change_database</code>) selalu lewat backup terverifikasi <strong>tanpa batas baris</strong> (hanya baris yang cocok dengan <code>WHERE</code>, kunci baris baru untuk <code>INSERT</code>, atau seluruh tabel), dry test + test restore yang di-rollback, lalu izin developer. Kartu izin menampilkan ukuran backup dan perkiraan lama lock. Prod tidak pernah <em>diizinkan selalu</em> dan menawarkan latihan lokal di SQLite dulu. Backup bisa dipulihkan dari kartu Database. <a href=\"/Docs/05-menu#database\" class=\"alert-link ms-2\">Database project →</a>", "<strong>🚀 AIT version 1.15.0</strong> — <strong>The planner can read and change project databases</strong>: the <strong>Database</strong> card in Project → Detail keeps SQL Server, PostgreSQL, MySQL, Oracle or SQLite connections on this machine only (password encrypted), with a Dev/Staging/Prod environment. The planner and the Tester read through <code>query_database</code> in a read-only transaction that is always rolled back, and sensitive columns reach the model as placeholders. A data change (<code>change_database</code>) always goes through a verified backup <strong>with no row limit</strong> (only the rows the <code>WHERE</code> matches, the keys of new rows for an <code>INSERT</code>, or the whole table), a rolled-back dry test and restore test, then the developer's permission. The permission card shows the backup size and about how long locks are held. Prod is never <em>always allowed</em> and offers a local SQLite rehearsal first. Backups can be restored from the Database card. <a href=\"/Docs/05-menu#database\" class=\"alert-link ms-2\">Project databases →</a>"))
                        </div>
                    </div>
                    <button type="button" class="btn btn-link alert-link update-toggle" aria-expanded="false" aria-controls="updateMore"
                            data-more="@Lang.T("4 versi sebelumnya ▾", "4 earlier versions ▾")" data-less="@Lang.T("Sembunyikan ▴", "Hide ▴")">@Lang.T("4 versi sebelumnya ▾", "4 earlier versions ▾")</button>
                </div>
            </div>
            @if (!string.Equals(controller, "Setup", StringComparison.OrdinalIgnoreCase))
            {
                @* Shown by site.js (initSetupStatus) while a required setup step is still open. *@
                <div id="setupNotice" class="alert alert-warning win-dismissible fade show mb-4 d-none" role="alert">
                    <win-controls for="alert" />
                    <div>
                        <strong>@Lang.T("Penyiapan AIT belum selesai", "AIT setup is not finished")</strong> — <span data-setup-count></span>@Lang.T(". Belum:", ". Not yet:") <span data-setup-open></span>.
                        <a asp-controller="Setup" asp-action="Index" class="alert-link ms-1">@Lang.T("Lanjutkan setup →", "Continue setup →")</a>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <partial name="_Onboarding" />

    <partial name="_SecurityNotice" />

    @* Asked once, the first time AIThread is opened, when no developer name is saved and git has no user.name (site.js). *@
    <div class="modal fade" id="developerNameModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="developerNameTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="developerNameForm" autocomplete="off" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="developerNameTitle">@Lang.T("Siapa nama Anda?", "What is your name?")</h5>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary">
                        @Html.Raw(Lang.T("Nama ini dicatat pada halaman wiki bisnis dan riwayat revisinya, supaya tim tahu siapa yang menulis atau mengubahnya bila memory dibagi antar developer. <span class=\"mono\">git config user.name</span> tidak ditemukan di komputer ini, jadi AIT menanyakannya sekali. Bisa diubah nanti di Pengaturan → Penyimpanan memory.", "This name is recorded on business wiki pages and their revision history, so the team knows who wrote or changed them when memory is shared between developers. <span class=\"mono\">git config user.name</span> was not found on this computer, so AIT asks once. You can change it later in Setting → Memory storage."))
                    </p>
                    <label class="form-label small" for="developerNameInput">@Lang.T("Nama developer", "Developer name")</label>
                    <input type="text" class="form-control" id="developerNameInput" maxlength="200" required />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="developerNameSave">@Lang.T("Simpan", "Save")</button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
