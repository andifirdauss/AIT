@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var appVersion = AIThread.UI.Hosting.Cli.Version;
    string Active(string name) =>string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="id" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIT</title>
    <script>
        // Apply the stored color mode before first paint to avoid a flash.
        (() => {
            try {
                const theme = localStorage.getItem('aithread-theme');
                if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-bs-theme', theme);
            } catch { }
        })();
    </script>
    <script type="importmap"></script>
    <link rel="icon" href="~/img/aithread.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIThread.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="app-brand" asp-controller="Home" asp-action="Index">
                <img class="app-brand-mark" src="~/img/aithread.svg" alt="" width="30" height="30" />
                <span>AIT</span>
            </a>
            <a id="npmUpdate" class="app-update d-none" href="https://www.npmjs.com/package/aithread" target="_blank" rel="noopener" data-version="@appVersion">
                <span class="app-update-dot"></span>
                <span class="app-update-text">Update tersedia</span>
            </a>
            @* Icons are one stroke SVG sprite so they share size and weight in every font (the old Unicode glyphs did not). *@
            <svg class="d-none" aria-hidden="true">
                <symbol id="nav-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></symbol>
                <symbol id="nav-project" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></symbol>
                <symbol id="nav-memory" viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="8" ry="2.5" /><path d="M4 5.5v6c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5v-6" /><path d="M4 11.5v6c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5v-6" /></symbol>
                <symbol id="nav-setup" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" /></symbol>
                <symbol id="nav-node" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="19" r="2.5" /><circle cx="19" cy="19" r="2.5" /><path d="M12 7.5v4m0 0L6.8 17m5.2-5.5 5.2 5.5" /></symbol>
                <symbol id="nav-cli" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3m6 0h4" /></symbol>
                <symbol id="nav-setting" viewBox="0 0 24 24"><path d="M4 6h10m4 0h2M4 12h4m4 0h8M4 18h12" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></symbol>
                <symbol id="nav-docs" viewBox="0 0 24 24"><path d="M3 5.5A1.5 1.5 0 0 1 4.5 4H9a3 3 0 0 1 3 3v13a2.5 2.5 0 0 0-2.5-2.5h-5A1.5 1.5 0 0 1 3 16z" /><path d="M21 5.5A1.5 1.5 0 0 0 19.5 4H15a3 3 0 0 0-3 3v13a2.5 2.5 0 0 1 2.5-2.5h5a1.5 1.5 0 0 0 1.5-1.5z" /></symbol>
                <symbol id="nav-guide" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.4M12 17h.01" /></symbol>
                <symbol id="nav-shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z" /><path d="m9 12 2 2 4-4" /></symbol>
            </svg>
            <nav class="app-nav">
                <div class="app-nav-section">Ruang kerja</div>
                <a class="app-nav-link @Active("Home") @Active("Thread")" asp-controller="Home" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-dashboard" /></svg>Dashboard</a>
                <a class="app-nav-link @Active("Project")" asp-controller="Project" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-project" /></svg>Project</a>
                <a class="app-nav-link @Active("Memory")" asp-controller="Memory" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-memory" /></svg>Memory</a>

                <div class="app-nav-section">Konfigurasi</div>
                <a class="app-nav-link @Active("Setup")" asp-controller="Setup" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-setup" /></svg>Setup<span class="app-nav-badge d-none" id="setupBadge"></span></a>
                <a class="app-nav-link @Active("Node")" asp-controller="Node" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-node" /></svg>Node</a>
                <a class="app-nav-link @Active("Cli")" asp-controller="Cli" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-cli" /></svg>CLI</a>
                <a class="app-nav-link @Active("Setting")" asp-controller="Setting" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-setting" /></svg>Setting</a>

                <div class="app-nav-section">Bantuan</div>
                <a class="app-nav-link @Active("Docs")" asp-controller="Docs" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-docs" /></svg>Docs</a>
                <button type="button" class="app-nav-link" id="onboardingOpen"><svg class="app-nav-icon"><use href="#nav-guide" /></svg>Panduan memulai</button>
                <button type="button" class="app-nav-link" id="securityNoticeOpen"><svg class="app-nav-icon"><use href="#nav-shield" /></svg>Keamanan &amp; privasi</button>
            </nav>
            <div class="app-sidebar-footer">
                <div id="routerPill" class="router-pill" title="Status koneksi 9router">
                    <span class="status-dot"></span><span class="router-pill-text">9router…</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-sidebar w-100 mt-2" id="themeToggle">Ganti tema</button>
            </div>
        </aside>
        <main class="app-main" role="main">
            @* One note per version released the same day, newest first. Only the newest shows; site.js (initUpdateBar)
               opens the rest, so the bar keeps its height however many versions there are. *@
            <div id="updateBar" class="alert alert-info win-dismissible fade show mb-4 d-none" role="alert" data-version="@appVersion">
                <win-controls for="alert" />
                <div class="update-notes">
                    <div class="update-note">
                        <strong>🚀 AIT versi @appVersion</strong> — <strong>Tugas yang gagal bisa diulang langsung dari chat</strong>: bila provider gangguan (mis. 503), balas <code>ulangi</code> dan AIT menjalankan lagi tugas yang belum berhasil dari thread terakhir dengan rencana yang sama, tanpa memanggil planner. Model yang menjawab kosong kini dilaporkan sebagai error provider dan langsung beralih ke node cadangan, bukan <em>No valid SEARCH/REPLACE block</em>; <em>Test</em> di menu Node juga menandainya gagal. Planner juga lebih cepat: tools node mendapat peta folder project, pertanyaan investigasi dikirim paralel per area dengan temuan lebih ringkas, dan progres menampilkan waktu tiap giliran model.
                        <a href="~/Docs/04-penggunaan#mengulang-tugas-yang-gagal" class="alert-link ms-2">Detail →</a>
                    </div>
                    <div class="update-more" id="updateMore" hidden>
                        <div class="update-note">
                            <strong>🚀 AIT versi 1.7.7</strong> — <strong>Tester bisa mencoba alur approval multi-user</strong>: isi <em>Akun uji</em> per project (peran + atribut, tanpa password per akun) di Project &gt; Detail, lalu Tester berganti user sendiri (<code>switch_user</code>), memakai fitur <em>login as</em> project bila terdeteksi, dan <strong>menyarankan test lanjutan</strong> (approve per level, edit sebelum approve, reject) yang bisa Anda jalankan dengan satu balasan. Untuk data yang hanya Anda tahu, balas <code>buat skenario test lanjutan 1</code>: AIT membuat file Excel untuk diisi, lalu menjalankannya langkah demi langkah. Logo baru.
                            <a href="~/Docs/07-cara-kerja#akun-uji-berganti-user" class="alert-link ms-2">Detail →</a>
                        </div>
                    </div>
                    <button type="button" class="btn btn-link alert-link update-toggle" aria-expanded="false" aria-controls="updateMore"
                            data-more="1 versi lain ▾" data-less="Sembunyikan ▴">1 versi lain ▾</button>
                </div>
            </div>
            @if (!string.Equals(controller, "Setup", StringComparison.OrdinalIgnoreCase))
            {
                @* Shown by site.js (initSetupStatus) while a required setup step is still open. *@
                <div id="setupNotice" class="alert alert-warning win-dismissible fade show mb-4 d-none" role="alert">
                    <win-controls for="alert" />
                    <div>
                        <strong>Setup AIT belum selesai</strong> — <span data-setup-count></span>. Belum: <span data-setup-open></span>.
                        <a asp-controller="Setup" asp-action="Index" class="alert-link ms-1">Lanjutkan setup →</a>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <partial name="_Onboarding" />

    <partial name="_SecurityNotice" />

    @* Asked once, the first time AIThread is opened, when no developer name is saved and git has no user.name (site.js). *@
    <div class="modal fade" id="developerNameModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="developerNameTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="developerNameForm" autocomplete="off" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="developerNameTitle">Siapa nama Anda?</h5>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary">
                        Nama ini dicatat pada halaman wiki bisnis dan riwayat revisinya, supaya tim tahu siapa yang menulis atau mengubahnya
                        bila memory dibagi antar developer. <span class="mono">git config user.name</span> tidak ditemukan di komputer ini, jadi
                        AIT menanyakannya sekali. Bisa diubah nanti di Setting → Penyimpanan memory.
                    </p>
                    <label class="form-label small" for="developerNameInput">Nama developer</label>
                    <input type="text" class="form-control" id="developerNameInput" maxlength="200" required />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="developerNameSave">Simpan</button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
