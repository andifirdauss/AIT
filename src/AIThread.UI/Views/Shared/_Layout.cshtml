@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var appVersion = AIThread.UI.Hosting.Cli.Version;
    string Active(string name) =>string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="@Lang.Current" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · AIT</title>
    <script>
        // Apply the stored color mode before first paint to avoid a flash.
        (() => {
            try {
                const theme = localStorage.getItem('aithread-theme');
                if (theme === 'light' || theme === 'dark') document.documentElement.setAttribute('data-bs-theme', theme);
            } catch { }
        })();
    </script>
    <script type="importmap"></script>
    <link rel="icon" href="~/img/aithread.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AIThread.UI.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="app-brand" asp-controller="Home" asp-action="Index">
                <img class="app-brand-mark" src="~/img/aithread.svg" alt="" width="30" height="30" />
                <span>AIT</span>
            </a>
            <a id="npmUpdate" class="app-update d-none" href="https://www.npmjs.com/package/aithread" target="_blank" rel="noopener" data-version="@appVersion">
                @Html.Raw(Lang.T("<span class=\"app-update-dot\"></span> <span class=\"app-update-text\">Update tersedia</span>", "<span class=\"app-update-dot\"></span> <span class=\"app-update-text\">Update available</span>"))
            </a>
            @* Icons are one stroke SVG sprite so they share size and weight in every font (the old Unicode glyphs did not). *@
            <svg class="d-none" aria-hidden="true">
                <symbol id="nav-dashboard" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></symbol>
                <symbol id="nav-project" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /></symbol>
                <symbol id="nav-memory" viewBox="0 0 24 24"><ellipse cx="12" cy="5.5" rx="8" ry="2.5" /><path d="M4 5.5v6c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5v-6" /><path d="M4 11.5v6c0 1.4 3.6 2.5 8 2.5s8-1.1 8-2.5v-6" /></symbol>
                <symbol id="nav-setup" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" /></symbol>
                <symbol id="nav-node" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="19" r="2.5" /><circle cx="19" cy="19" r="2.5" /><path d="M12 7.5v4m0 0L6.8 17m5.2-5.5 5.2 5.5" /></symbol>
                <symbol id="nav-cli" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 3 3-3 3m6 0h4" /></symbol>
                <symbol id="nav-setting" viewBox="0 0 24 24"><path d="M4 6h10m4 0h2M4 12h4m4 0h8M4 18h12" /><circle cx="16" cy="6" r="2" /><circle cx="10" cy="12" r="2" /><circle cx="18" cy="18" r="2" /></symbol>
                <symbol id="nav-docs" viewBox="0 0 24 24"><path d="M3 5.5A1.5 1.5 0 0 1 4.5 4H9a3 3 0 0 1 3 3v13a2.5 2.5 0 0 0-2.5-2.5h-5A1.5 1.5 0 0 1 3 16z" /><path d="M21 5.5A1.5 1.5 0 0 0 19.5 4H15a3 3 0 0 0-3 3v13a2.5 2.5 0 0 1 2.5-2.5h5a1.5 1.5 0 0 0 1.5-1.5z" /></symbol>
                <symbol id="nav-guide" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.4M12 17h.01" /></symbol>
                <symbol id="nav-shield" viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.5 3 8.3 7 10 4-1.7 7-5.5 7-10V6z" /><path d="m9 12 2 2 4-4" /></symbol>
            </svg>
            <nav class="app-nav">
                <div class="app-nav-section">@Lang.T("Ruang kerja", "Workspace")</div>
                <a class="app-nav-link @Active("Home") @Active("Thread")" asp-controller="Home" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-dashboard" /></svg>@Lang.T("Dasbor", "Dashboard")</a>
                <a class="app-nav-link @Active("Project")" asp-controller="Project" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-project" /></svg>@Lang.T("Proyek", "Project")</a>
                <a class="app-nav-link @Active("Memory")" asp-controller="Memory" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-memory" /></svg>@Lang.T("Memori", "Memory")</a>

                <div class="app-nav-section">@Lang.T("Konfigurasi", "Configuration")</div>
                <a class="app-nav-link @Active("Setup")" asp-controller="Setup" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-setup" /></svg>@Lang.T("Penyiapan", "Setup")<span class="app-nav-badge d-none" id="setupBadge"></span></a>
                <a class="app-nav-link @Active("Node")" asp-controller="Node" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-node" /></svg>Node</a>
                <a class="app-nav-link @Active("Cli")" asp-controller="Cli" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-cli" /></svg>CLI</a>
                <a class="app-nav-link @Active("Setting")" asp-controller="Setting" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-setting" /></svg>@Lang.T("Pengaturan", "Setting")</a>

                <div class="app-nav-section">@Lang.T("Bantuan", "Help")</div>
                <a class="app-nav-link @Active("Docs")" asp-controller="Docs" asp-action="Index"><svg class="app-nav-icon"><use href="#nav-docs" /></svg>@Lang.T("Dokumentasi", "Docs")</a>
                <button type="button" class="app-nav-link" id="onboardingOpen"><svg class="app-nav-icon"><use href="#nav-guide" /></svg>@Lang.T("Panduan memulai", "Getting started")</button>
                <button type="button" class="app-nav-link" id="securityNoticeOpen"><svg class="app-nav-icon"><use href="#nav-shield" /></svg>@Lang.T("Keamanan & privasi", "Security & privacy")</button>
            </nav>
            <div class="app-sidebar-footer">
                <div id="routerPill" class="router-pill" title="@Lang.T("Status koneksi 9router", "9router connection status")">
                    <span class="status-dot"></span><span class="router-pill-text">9router…</span>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-sidebar w-100 mt-2" id="themeToggle">@Lang.T("Ganti tema", "Switch theme")</button>
                <select class="form-select form-select-sm btn-sidebar w-100 mt-2" id="languageSelect" aria-label="Bahasa / Language" title="Bahasa AIT: UI, output ke CLI, log / AIT language: UI, CLI output, logs">
                    <option value="id">🌐 Bahasa Indonesia</option>
                    <option value="en">🌐 English</option>
                </select>
            </div>
        </aside>
        <main class="app-main" role="main">
            @* The newest version's note, then the earlier ones, newest first. Only the newest shows; site.js (initUpdateBar)
               opens the rest, so the bar keeps its height however many versions there are. *@
            <div id="updateBar" class="alert alert-info win-dismissible fade show mb-4 d-none" role="alert" data-version="@appVersion">
                <win-controls for="alert" />
                <div class="update-notes">
                    <div class="update-note">
                        <strong>🚀 AIT @Lang.T("versi", "version") @appVersion</strong> — @Html.Raw(Lang.T(
                            "<strong>AIT tidak lagi terkunci di folder project, dengan izin Anda</strong>: AIT bisa mengubah file di folder/project lain, menjalankan perintah lewat tool <code>run_command</code>, dan <strong>commit &amp; push</strong> bila Anda memintanya. Sebelum itu thread berhenti dengan kartu izin: <strong>1. Izinkan sekali</strong>, <strong>2. Izinkan selalu</strong>, <strong>3. Tolak</strong>, dijawab di CLI atau tombol di halaman thread. Perintah baca saja (curl GET ke localhost untuk melihat response API, git read, cek versi) langsung jalan; curl ke API luar diizinkan per host. Izin <em>selalu</em> bisa dicabut di Project → Detail → <em>Izin AIT</em>. Juga baru: <strong>memory mengikuti git</strong> (status commit/push perubahan tiap thread, environment, wiki per environment, dan commit di luar AIT ikut dirangkum).",
                            "<strong>AIT is no longer locked to the project folder, with your permission</strong>: AIT can change files in another folder or project, run commands through the <code>run_command</code> tool, and <strong>commit &amp; push</strong> when you ask for it. Before that the thread stops with a permission card: <strong>1. Allow once</strong>, <strong>2. Always allow</strong>, <strong>3. Deny</strong>, answered in the CLI or with the buttons on the thread page. Read-only commands (curl GET to localhost to see an API response, git reads, version checks) run at once; curl to an outside API is allowed per host. <em>Always</em> permissions can be revoked in Project → Detail → <em>AIT permissions</em>. Also new: <strong>memory follows git</strong> (the commit/push state of each thread's change, environments, a wiki per environment, and commits made outside AIT are summarized too)."))
                        <a href="@Lang.T("/Docs/04-penggunaan#izin-developer", "/Docs/04-penggunaan#developer-permission")" class="alert-link ms-2">@Lang.T("Izin →", "Permission →")</a>
                        <a href="@Lang.T("/Docs/07-cara-kerja#status-git-perubahan-thread", "/Docs/07-cara-kerja#git-state-of-a-threads-change")" class="alert-link ms-2">@Lang.T("Git →", "Git →")</a>
                    </div>
                    <div class="update-more" id="updateMore" hidden>
                        <div class="update-note">
                            @Html.Raw(Lang.T("<strong>🚀 AIT versi 1.8.1</strong> — <strong>Nama class dan file tidak lagi ikut tersamarkan sebagai secret</strong>: nama kode seperti <code>LunchClaimRateHeaderDto</code> kini hanya disamarkan di tempat ia menjadi secret, bukan di semua teks, dan path yang terlanjur dilihat model sebagai <code>{{AIT_SECRET:…}}</code> dipulihkan sebelum tool planner berjalan dan sebelum rencana divalidasi. Nilai yang salah terdeteksi bisa ditandai <strong>Bukan secret</strong> di Pengaturan → Keamanan &amp; privasi → <em>Secret yang terdeteksi</em>. <a href=\"/Docs/12-keamanan#secret-yang-terdeteksi-bukan-secret\" class=\"alert-link ms-2\">Detail →</a>", "<strong>🚀 AIT version 1.8.1</strong> — <strong>Class and file names are no longer masked as secrets</strong>: a code name such as <code>LunchClaimRateHeaderDto</code> is now only masked where it is the secret, not in every text, and a path the model already saw as <code>{{AIT_SECRET:…}}</code> is restored before planner tools run and before the plan is validated. A value detected by mistake can be marked <strong>Not secret</strong> in Setting → Security &amp; privacy → <em>Detected secrets</em>. <a href=\"/Docs/12-keamanan#detected-secrets-not-secret\" class=\"alert-link ms-2\">Details →</a>"))
                        </div>
                        <div class="update-note">
                            @Html.Raw(Lang.T("<strong>🚀 AIT versi 1.8.0</strong> — <strong>AIT kini dua bahasa (Indonesia / English)</strong>: pilih di kotak bahasa di bawah sidebar, lalu halaman web, menu <code>AIThread.exe</code>, log aktivitas, pesan API, Telegram, dan Dokumentasi ikut berganti. Output AIT di CLI mengikuti bahasa prompt Anda, apa pun bahasa tampilannya, dan perintah chat (<code>ulangi</code> / <code>retry</code>, …) dikenali dalam dua bahasa. <strong>Project memory kini bergaya MEMORY.md</strong>: satu catatan perubahan per thread (fitur, file yang berubah, validasi &amp; flow) dirangkum menjadi <em>ringkasan modul</em> yang dibaca utuh oleh planner. Memory lama dimigrasi otomatis (dengan backup) dan progresnya tampil di menu Memori; deskripsi memory juga bisa dipratinjau sebagai Markdown. <a href=\"/Docs/02-konfigurasi#bahasa-tampilan\" class=\"alert-link ms-2\">Bahasa →</a> <a href=\"/Docs/06-memory#catatan-perubahan-project-memory\" class=\"alert-link ms-2\">Memory →</a>", "<strong>🚀 AIT version 1.8.0</strong> — <strong>AIT is now bilingual (Indonesian / English)</strong>: choose it in the language box at the bottom of the sidebar, and the web pages, the <code>AIThread.exe</code> menu, the activity log, API messages, Telegram and the Docs follow. AIT's output in the CLI follows the language of your prompt, whatever the display language, and chat commands (<code>ulangi</code> / <code>retry</code>, …) are recognized in both languages. <strong>Project memory is now MEMORY.md style</strong>: one change entry per thread (feature, changed files, validation &amp; flow) is folded into a <em>module summary</em> the planner reads in full. Old memory is migrated automatically (with a backup) and its progress shows in the Memory menu; memory descriptions can be previewed as Markdown too. <a href=\"/Docs/02-konfigurasi#display-language\" class=\"alert-link ms-2\">Language →</a> <a href=\"/Docs/06-memory#change-entries-project-memory\" class=\"alert-link ms-2\">Memory →</a>"))
                        </div>
                        <div class="update-note">
                            @Html.Raw(Lang.T("<strong>🚀 AIT versi 1.7.10</strong> — <strong>Tester tidak lagi menebak URL API</strong>: path endpoint dibaca dari atribut route di kode (<code>[controller]</code> = nama class tanpa <em>Controller</em>, jadi <code>OutletUnionApiController</code> → <code>/OutletUnionApi</code>), target skenario yang salah eja dikoreksi otomatis, dan setelah 404 Tester diberi route terdekat atau dokumen OpenAPI dari Swagger UI, bukan berakhir <em>blocked</em>. Akun uji, Tester multi-user, test lanjutan, dan skenario Excel (1.7.7) kini juga ada bersama <code>ulangi</code> dari chat dan penyamaran secret (1.7.8–1.7.9). <a href=\"/Docs/07-cara-kerja#endpoint-dari-kode\" class=\"alert-link ms-2\">Detail →</a>", "<strong>🚀 AIT version 1.7.10</strong> — <strong>The Tester no longer guesses API URLs</strong>: endpoint paths are read from the route attributes in the code (<code>[controller]</code> = the class name without <em>Controller</em>, so <code>OutletUnionApiController</code> → <code>/OutletUnionApi</code>), a misspelled scenario target is corrected automatically, and after a 404 the Tester gets the nearest route or the OpenAPI document from Swagger UI instead of ending <em>blocked</em>. Test accounts, the multi-user Tester, follow-up tests and Excel scenarios (1.7.7) now come along with <code>retry</code> from the chat and secret masking (1.7.8–1.7.9). <a href=\"/Docs/07-cara-kerja#endpoints-from-the-code\" class=\"alert-link ms-2\">Details →</a>"))
                        </div>
                    </div>
                    <button type="button" class="btn btn-link alert-link update-toggle" aria-expanded="false" aria-controls="updateMore"
                            data-more="@Lang.T("3 versi sebelumnya ▾", "3 earlier versions ▾")" data-less="@Lang.T("Sembunyikan ▴", "Hide ▴")">@Lang.T("3 versi sebelumnya ▾", "3 earlier versions ▾")</button>
                </div>
            </div>
            @if (!string.Equals(controller, "Setup", StringComparison.OrdinalIgnoreCase))
            {
                @* Shown by site.js (initSetupStatus) while a required setup step is still open. *@
                <div id="setupNotice" class="alert alert-warning win-dismissible fade show mb-4 d-none" role="alert">
                    <win-controls for="alert" />
                    <div>
                        <strong>@Lang.T("Penyiapan AIT belum selesai", "AIT setup is not finished")</strong> — <span data-setup-count></span>@Lang.T(". Belum:", ". Not yet:") <span data-setup-open></span>.
                        <a asp-controller="Setup" asp-action="Index" class="alert-link ms-1">@Lang.T("Lanjutkan setup →", "Continue setup →")</a>
                    </div>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

    <partial name="_Onboarding" />

    <partial name="_SecurityNotice" />

    @* Asked once, the first time AIThread is opened, when no developer name is saved and git has no user.name (site.js). *@
    <div class="modal fade" id="developerNameModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="developerNameTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form class="modal-content" id="developerNameForm" autocomplete="off" novalidate>
                <div class="modal-header">
                    <h5 class="modal-title" id="developerNameTitle">@Lang.T("Siapa nama Anda?", "What is your name?")</h5>
                </div>
                <div class="modal-body">
                    <p class="small text-secondary">
                        @Html.Raw(Lang.T("Nama ini dicatat pada halaman wiki bisnis dan riwayat revisinya, supaya tim tahu siapa yang menulis atau mengubahnya bila memory dibagi antar developer. <span class=\"mono\">git config user.name</span> tidak ditemukan di komputer ini, jadi AIT menanyakannya sekali. Bisa diubah nanti di Pengaturan → Penyimpanan memory.", "This name is recorded on business wiki pages and their revision history, so the team knows who wrote or changed them when memory is shared between developers. <span class=\"mono\">git config user.name</span> was not found on this computer, so AIT asks once. You can change it later in Setting → Memory storage."))
                    </p>
                    <label class="form-label small" for="developerNameInput">@Lang.T("Nama developer", "Developer name")</label>
                    <input type="text" class="form-control" id="developerNameInput" maxlength="200" required />
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" id="developerNameSave">@Lang.T("Simpan", "Save")</button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
