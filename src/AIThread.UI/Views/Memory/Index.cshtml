@{
    ViewData["Title"] = "Memory";
    var projectId = ViewData["ProjectId"] as Guid?;
}

<div class="page-header">
    <div>
        <h1>Memory</h1>
        <p class="page-subtitle">Pengetahuan yang disarikan dari thread. Planner menyaring lewat <strong>label</strong> (Modul · Layer · Jenis), memilih dengan <strong>keyword</strong>, lalu membaca deskripsi yang relevan saja. Memory project dibagi antar developer lewat <a href="/Project">project key</a>.</p>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="memoryTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="memory-list-tab" data-bs-toggle="tab" data-bs-target="#tab-memory-list" data-tab="" type="button" role="tab" aria-controls="tab-memory-list" aria-selected="true">Short &amp; long memory</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="review-tab" data-bs-toggle="tab" data-bs-target="#tab-review" data-tab="review" type="button" role="tab" aria-controls="tab-review" aria-selected="false">Perlu review <span class="badge text-bg-warning d-none" id="reviewBadge"></span></button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="business-tab" data-bs-toggle="tab" data-bs-target="#tab-business" data-tab="bisnis" type="button" role="tab" aria-controls="tab-business" aria-selected="false">Bisnis (wiki)</button>
    </li>
</ul>

<div class="alert alert-info d-none small" id="changelogBanner" role="status">
    <div id="changelogText"></div>
    <div class="progress mt-2 d-none" id="changelogProgress" style="height: 6px;" role="progressbar" aria-label="Kemajuan putaran migrasi" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="progress-bar progress-bar-striped progress-bar-animated" id="changelogBar"></div>
    </div>
</div>
<div class="alert alert-info d-none d-flex flex-wrap align-items-center gap-2 small" id="relabelBanner" role="status">
    <div class="me-auto" id="relabelText"></div>
    <button type="button" class="btn btn-outline-primary btn-sm" id="btnRelabel">Jalankan sekarang</button>
</div>

<div class="tab-content">
<div class="tab-pane active" id="tab-memory-list" role="tabpanel" aria-labelledby="memory-list-tab" tabindex="0">
<div class="d-flex justify-content-end gap-2 mb-3">
    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnExport" title="Unduh memory sesuai filter di bawah sebagai file JSON">Export</button>
    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnImport" title="Masukkan memory dari file export AIT">Import</button>
    <input type="file" class="d-none" id="importFile" accept="application/json,.json" />
    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnConsolidate">Konsolidasi sekarang</button>
    <button type="button" class="btn btn-primary btn-sm" id="btnAdd">Tambah memory</button>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Short memory</div><div class="stat-value" id="statShort">–</div><div class="stat-hint" id="statRedis">&nbsp;</div>
    </div></div></div>
    <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Long · Database</div><div class="stat-value" id="statLong">–</div><div class="stat-hint">hasil dump short &gt; 1 hari</div>
    </div></div></div>
    <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Project memory</div><div class="stat-value" id="statProject">–</div><div class="stat-hint">bisnis, validasi, flow</div>
    </div></div></div>
    <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Knowledge memory</div><div class="stat-value" id="statKnowledge">–</div><div class="stat-hint">pola umum lintas project</div>
    </div></div></div>
    <div class="col-6 col-lg"><div class="card stat-card h-100"><div class="card-body">
        <div class="stat-label">Belum berlabel</div><div class="stat-value" id="statUnlabeled">–</div><div class="stat-hint" id="statReview">&nbsp;</div>
    </div></div></div>
</div>

<div class="card">
    <div class="card-body border-bottom">
        <div class="row g-2">
            <div class="col-md-2">
                <select class="form-select form-select-sm" id="filterLevel">
                    <option value="">Semua level</option><option value="Short">Short</option><option value="Long">Long</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select form-select-sm" id="filterType">
                    <option value="">Semua tipe</option><option value="Project">Project</option><option value="Knowledge">Knowledge</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select form-select-sm" id="filterProject"><option value="">Semua project</option></select>
            </div>
            <div class="col-md-5">
                <input type="search" class="form-control form-control-sm" id="filterSearch" placeholder="Cari label atau deskripsi…" />
            </div>
        </div>
        <div class="row g-2 mt-0">
            <div class="col-md-3">
                <select class="form-select form-select-sm" id="filterModule" title="Modul dari project yang dipilih (dan knowledge)"><option value="">Semua modul</option></select>
            </div>
            <div class="col-md-2">
                <select class="form-select form-select-sm" id="filterLayer">
                    <option value="">Semua layer</option><option>UI</option><option>Entry</option><option>Logic</option><option>Data</option><option>Infra</option><option>Test</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select form-select-sm" id="filterKind">
                    <option value="">Semua jenis</option><option value="Change">Change (catatan perubahan)</option><option value="Summary">Summary (kondisi modul)</option><option>Pitfall</option><option>Rule</option><option>Flow</option><option>Convention</option><option>Architecture</option><option>Pattern</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select form-select-sm" id="filterLabeled">
                    <option value="">Berlabel &amp; belum</option><option value="true">Berlabel</option><option value="false">Belum berlabel</option>
                </select>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Level</th><th>Tipe</th><th>Project</th><th style="width:40%">Label</th><th>Dibuat</th><th>Dipakai</th><th></th></tr></thead>
            <tbody id="memoryRows"><tr><td colspan="7" class="empty-state">Memuat…</td></tr></tbody>
        </table>
    </div>
    <div class="card-footer d-flex justify-content-between align-items-center small">
        <span class="text-secondary" id="pageInfo"></span>
        <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-secondary" id="btnPrev">‹ Sebelumnya</button>
            <button type="button" class="btn btn-outline-secondary" id="btnNext">Berikutnya ›</button>
        </div>
    </div>
</div>
</div>

<div class="tab-pane" id="tab-review" role="tabpanel" aria-labelledby="review-tab" tabindex="0">
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5 col-xl-4">
                    <label class="form-label small text-secondary" for="reviewProject">Project</label>
                    <select class="form-select form-select-sm" id="reviewProject"><option value="">Semua project (memory saja)</option></select>
                </div>
                <div class="col small text-secondary">
                    Memory yang tidak bisa dilabeli otomatis, saran gabung modul yang keyakinannya rendah, dan pasangan memory yang kemungkinan sama.
                    Merge dengan keyakinan tinggi sudah diterapkan otomatis dan bisa dibatalkan di detail project.
                </div>
            </div>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-header">Memory tanpa label <span class="text-secondary small" id="reviewMemoryCount"></span></div>
        <div class="list-group list-group-flush" id="reviewMemories"><div class="list-group-item text-secondary small">Memuat…</div></div>
    </div>
    <div class="card mb-3">
        <div class="card-header">Saran gabung modul <span class="text-secondary small" id="reviewMergeCount"></span></div>
        <div class="list-group list-group-flush" id="reviewMerges"><div class="list-group-item text-secondary small">Memuat…</div></div>
    </div>
    <div class="card">
        <div class="card-header">Kandidat memory duplikat <span class="text-secondary small" id="reviewDuplicateCount"></span></div>
        <div class="list-group list-group-flush" id="reviewDuplicates"><div class="list-group-item text-secondary small">Memuat…</div></div>
    </div>
</div>

<div class="tab-pane" id="tab-business" role="tabpanel" aria-labelledby="business-tab" tabindex="0">
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5 col-xl-4">
                    <label class="form-label small text-secondary" for="bizProject">Project</label>
                    <select class="form-select form-select-sm" id="bizProject"></select>
                </div>
                <div class="col-md-7 col-xl-8 d-flex flex-wrap gap-2 justify-content-md-end">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnBizDigest" title="Rangkum thread yang belum masuk wiki sekarang">Perbarui sekarang</button>
                    <button type="button" class="btn btn-primary btn-sm" id="btnBizNew">Halaman baru</button>
                </div>
            </div>
            <div class="small text-secondary mt-2" id="bizInfo"></div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4 col-xl-3">
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <span>Modul</span>
                    <input type="search" class="form-control form-control-sm ms-auto w-50" id="bizFilter" placeholder="Cari…" aria-label="Cari halaman" />
                </div>
                <div class="list-group list-group-flush small" id="bizPages"><div class="list-group-item text-secondary">Memuat…</div></div>
            </div>
        </div>
        <div class="col-lg-8 col-xl-9">
            <div class="card" id="bizView">
                <div class="card-body empty-state" id="bizEmpty">
                    Pilih halaman di kiri. Wiki bisnis dibangun otomatis dari pekerjaan developer (Setting → Penyimpanan memory → Business memory),
                    dan bisa ditulis atau diperbaiki manual dengan <strong>Halaman baru</strong>.
                </div>
                <div class="d-none" id="bizPage">
                    <div class="card-header d-flex flex-wrap align-items-center gap-2">
                        <div class="me-auto small text-secondary" id="bizPageMeta"></div>
                        <div class="form-check form-switch mb-0 small" title="Matikan untuk halaman yang dikurasi manual: penulis wiki AI tidak akan mengubahnya.">
                            <input class="form-check-input" type="checkbox" role="switch" id="bizAutoUpdate" />
                            <label class="form-check-label" for="bizAutoUpdate">Diperbarui AI</label>
                        </div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnBizHistory">Riwayat</button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnBizEdit">Edit</button>
                        <button type="button" class="btn btn-outline-danger btn-sm" id="btnBizDelete">Hapus</button>
                    </div>
                    <div class="card-body docs-body" id="bizContent"></div>
                </div>
            </div>

            <form class="card d-none" id="bizEditor" autocomplete="off" novalidate>
                <div class="card-header" id="bizEditorTitle">Halaman baru</div>
                <div class="card-body">
                    <div class="row g-2 mb-2">
                        <div class="col-md-3">
                            <label class="form-label small" for="bizModule">Modul</label>
                            <input type="text" class="form-control" id="bizModule" maxlength="100" placeholder="TransferOrder" title="Modul yang sama dengan label memory; alias dan penulisan lain diarahkan ke modul yang sudah ada" required />
                        </div>
                        <div class="col-md-9">
                            <label class="form-label small" for="bizTitle">Judul</label>
                            <input type="text" class="form-control" id="bizTitle" maxlength="200" placeholder="Transfer Order" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small" for="bizSummary">Ringkasan</label>
                        <input type="text" class="form-control" id="bizSummary" maxlength="1000" placeholder="Satu-dua kalimat: modul ini untuk apa" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small" for="bizLabels">Label (keyword dipisah koma untuk planner, disimpan PascalCase)</label>
                        <input type="text" class="form-control" id="bizLabels" maxlength="500" placeholder="TransferOrder, Mutasi, Gudang" />
                    </div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <label class="form-label small mb-0" for="bizBody">Isi (Markdown — tabel didukung)</label>
                        <div class="ms-auto btn-group btn-group-sm" role="group" aria-label="Mode editor">
                            <button type="button" class="btn btn-outline-secondary active" id="btnBizWrite">Tulis</button>
                            <button type="button" class="btn btn-outline-secondary" id="btnBizPreview">Pratinjau</button>
                        </div>
                        <label class="btn btn-outline-secondary btn-sm mb-0" for="bizImageFile">Sisipkan gambar</label>
                        <input type="file" class="d-none" id="bizImageFile" accept="image/png,image/jpeg,image/gif,image/webp" />
                    </div>
                    <textarea class="form-control mono small" id="bizBody" rows="22" required></textarea>
                    <div class="card card-body docs-body d-none" id="bizPreview"></div>
                    <div class="form-text">Tempel screenshot langsung (Ctrl+V) ke editor. Gambar disimpan di store business memory dan ditulis sebagai <span class="mono">![keterangan](asset:…)</span>.</div>
                    <div class="row g-2 mt-1">
                        <div class="col-md-8">
                            <label class="form-label small" for="bizChangeNote">Catatan perubahan</label>
                            <input type="text" class="form-control form-control-sm" id="bizChangeNote" maxlength="1000" placeholder="mis. Tambah aturan approval TO di atas 10 juta" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="bizEditorAutoUpdate" checked />
                                <label class="form-check-label small" for="bizEditorAutoUpdate">Boleh diperbarui AI</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" id="btnBizCancel">Batal</button>
                    <button type="submit" class="btn btn-primary" id="btnBizSave">Simpan</button>
                </div>
            </form>
        </div>
    </div>
</div>
</div>

<div class="modal fade" id="bizHistoryModal" tabindex="-1" aria-labelledby="bizHistoryTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="bizHistoryTitle">Riwayat halaman</h5>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-4"><div class="list-group small" id="bizRevisions"></div></div>
                    <div class="col-md-8">
                        <div class="d-flex align-items-center mb-2">
                            <span class="small text-secondary" id="bizRevisionMeta"></span>
                            <button type="button" class="btn btn-outline-primary btn-sm ms-auto d-none" id="btnBizRestore">Pulihkan versi ini</button>
                        </div>
                        <div class="docs-body border rounded p-3" id="bizRevisionContent"><span class="text-secondary">Pilih versi.</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="memoryModal" tabindex="-1" aria-labelledby="memoryModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form class="modal-content" id="memoryForm">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="memoryModalTitle">Memory</h5>
            </div>
            <div class="modal-body">
                <input type="hidden" id="memoryId" />
                <input type="hidden" id="memoryLevel" />
                <div class="row g-2 mb-2">
                    <div class="col-md-4">
                        <label class="form-label small" for="memoryType">Tipe</label>
                        <select class="form-select" id="memoryType">
                            <option value="Project">Project — spesifik project</option>
                            <option value="Knowledge">Knowledge — umum</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small" for="memoryProject">Project</label>
                        <select class="form-select" id="memoryProject"></select>
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-md-5">
                        <label class="form-label small" for="memoryModule">Modul</label>
                        <div class="input-group">
                            <select class="form-select" id="memoryModule" required></select>
                            <button type="button" class="btn btn-outline-secondary" id="btnModuleRename" title="Ubah nama atau huruf besar-kecil modul ini; semua memory, peta kode, dan wiki modul ini ikut berubah">Ubah nama</button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small" for="memoryKind">Jenis</label>
                        <select class="form-select" id="memoryKind" required>
                            <option value="Change">Change — catatan perubahan (fitur, file, validasi, flow)</option>
                            <option value="Summary">Summary — kondisi modul saat ini</option>
                            <optgroup label="Format lama (project: dilipat ke ringkasan modul)">
                                <option value="Pitfall">Pitfall — jebakan/bug &amp; solusinya</option>
                                <option value="Rule">Rule — aturan bisnis &amp; validasi</option>
                                <option value="Flow">Flow — urutan langkah</option>
                                <option value="Convention">Convention — cara menulis kode di sini</option>
                                <option value="Architecture">Architecture — susunan &amp; alasan desain</option>
                                <option value="Pattern">Pattern — solusi teknis umum</option>
                            </optgroup>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small" for="memoryArea">Area <span class="text-secondary">(opsional)</span></label>
                        <input type="text" class="form-control" id="memoryArea" maxlength="100" placeholder="Web" title="Aplikasi di repo multi-aplikasi" />
                    </div>
                </div>
                <div class="input-group input-group-sm mb-2 d-none" id="memoryModuleEdit">
                    <span class="input-group-text" id="memoryModuleEditLabel">Modul baru</span>
                    <input type="text" class="form-control" id="memoryModuleName" maxlength="100" placeholder="KlaimDF" aria-labelledby="memoryModuleEditLabel" />
                    <button type="button" class="btn btn-primary" id="btnModuleNameSave">Simpan</button>
                    <button type="button" class="btn btn-outline-secondary" id="btnModuleNameCancel">Batal</button>
                </div>
                <div class="form-text mt-0 mb-2">Singkatan ditulis kapital: <span class="mono">MKPP</span>, <span class="mono">KlaimDF</span>.</div>
                <div class="mb-2">
                    <label class="form-label small" for="memoryExtraSelect">Modul lain <span class="text-secondary">(opsional, maksimal 3)</span></label>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="d-flex flex-wrap gap-1" id="memoryExtraModules"></div>
                        <select class="form-select form-select-sm w-auto" id="memoryExtraSelect"></select>
                    </div>
                    <div class="form-text">Modul lain yang juga dibahas memory ini. Filter modul dan pencarian planner ikut menemukan memory ini lewat modul-modul tersebut.</div>
                </div>
                <div class="mb-2">
                    <span class="form-label small d-block">Layer</span>
                    <div class="d-flex flex-wrap gap-3" id="memoryLayers">
                        <div class="form-check"><input class="form-check-input" type="checkbox" value="UI" id="layerUI"><label class="form-check-label small" for="layerUI">UI</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" value="Entry" id="layerEntry"><label class="form-check-label small" for="layerEntry">Entry</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" value="Logic" id="layerLogic"><label class="form-check-label small" for="layerLogic">Logic</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" value="Data" id="layerData"><label class="form-check-label small" for="layerData">Data</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" value="Infra" id="layerInfra"><label class="form-check-label small" for="layerInfra">Infra</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" value="Test" id="layerTest"><label class="form-check-label small" for="layerTest">Test</label></div>
                    </div>
                </div>
                <div class="mb-2">
                    <label class="form-label small" for="memoryKeywords">Keyword <span class="text-secondary" id="memoryKeywordCount"></span></label>
                    <input type="text" class="form-control" id="memoryKeywords" placeholder="Description, Deskripsi, UserValidator" required />
                    <div class="form-text">Dipisah koma, maksimal 16. Ditulis dalam PascalCase otomatis (singkatan seperti API, DTO, UI jadi kapital); nama class dari kode tetap seperti aslinya.</div>
                </div>
                <div class="small text-secondary mb-2 d-none" id="memoryLegacy"></div>
                <div>
                    <label class="form-label small" for="memoryDescription">Deskripsi</label>
                    <textarea class="form-control font-monospace small" id="memoryDescription" rows="12" required></textarea>
                </div>
                <div class="small text-secondary mt-2" id="memoryMeta"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="submit" class="btn btn-primary">Simpan</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="importModal" tabindex="-1" aria-labelledby="importModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header win-bar">
                <win-controls for="modal" />
                <h5 class="modal-title" id="importModalTitle">Import memory</h5>
            </div>
            <div class="modal-body">
                <div class="small text-secondary mb-2" id="importFileInfo"></div>
                <div class="mb-3">
                    <label class="form-label small" for="importMode">Memory dengan id yang sudah ada</label>
                    <select class="form-select form-select-sm" id="importMode">
                        <option value="Skip">Lewati — biarkan yang sudah ada</option>
                        <option value="Overwrite">Timpa — pakai tipe, project, label, dan deskripsi dari file</option>
                    </select>
                </div>
                <div id="importPreview"><span class="text-secondary small">Memeriksa file…</span></div>
                <div class="form-text mt-3">Memory yang isinya sama (project, tipe, label, deskripsi) dengan memory yang sudah ada tidak digandakan. Import aman diulang. Short memory tetap short dan pindah ke long memory sesuai umurnya.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Tutup</button>
                <button type="button" class="btn btn-primary" id="btnImportConfirm" disabled>Import</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>window.initialProjectId = '@(projectId?.ToString() ?? "")';</script>
    <script src="~/js/pages/memory.js" asp-append-version="true"></script>
