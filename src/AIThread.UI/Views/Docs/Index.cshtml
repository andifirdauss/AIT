@model DocsViewModel
@{
    var current = Model.Page?.Entry.Slug;
    string DocUrl(string slug) => Url.Action("Index", "Docs", new { slug = slug.Length == 0 ? null : slug })!;
}

<div class="page-header">
    <div>
        <h1>@Lang.T("Dokumentasi", "Docs")</h1>
        <p class="page-subtitle">@Html.Raw(Lang.T("Panduan pemakaian AIT, dibaca langsung dari folder <span class=\"mono\">docs/</span> di repo.", "The AIT user guide, read straight from the <span class=\"mono\">docs/</span> folder of the repo."))</p>
    </div>
</div>

@if (!Model.DocsFound)
{
    <div class="alert alert-warning">
        @Html.Raw(Lang.T("Folder <span class=\"mono\">docs/</span> tidak ditemukan. Jalankan aplikasi dari repo (folder <span class=\"mono\">docs/</span> dua tingkat di atas <span class=\"mono\">src/AIThread.UI</span>), build ulang agar dokumen tersalin ke folder output, atau atur <span class=\"mono\">AIThread:DocsPath</span> di <span class=\"mono\">appsettings.json</span>.", "The <span class=\"mono\">docs/</span> folder was not found. Run the application from the repo (the <span class=\"mono\">docs/</span> folder two levels above <span class=\"mono\">src/AIThread.UI</span>), rebuild so the documents are copied to the output folder, or set <span class=\"mono\">AIThread:DocsPath</span> in <span class=\"mono\">appsettings.json</span>."))
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-lg-3">
            <div class="docs-sidebar">
                <input type="search" class="form-control form-control-sm mb-2" id="docsFilter" placeholder="@Lang.T("Cari judul…", "Search titles…")" aria-label="@Lang.T("Cari judul dokumen", "Search document titles")" />
                <nav class="list-group list-group-flush docs-nav" id="docsNav">
                    @foreach (var entry in Model.Entries)
                    {
                        var active = string.Equals(entry.Slug, current, StringComparison.OrdinalIgnoreCase);
                        <a class="list-group-item list-group-item-action @(active ? "active" : "")" href="@DocUrl(entry.Slug)" aria-current="@(active ? "page" : null)">@entry.Title</a>
                    }
                </nav>

                @if (Model.Page is { Headings.Count: > 0 } page)
                {
                    <div class="docs-toc mt-3">
                        <div class="small text-secondary text-uppercase mb-1">@Lang.T("Di halaman ini", "On this page")</div>
                        @foreach (var heading in page.Headings)
                        {
                            <a class="level-@heading.Level" href="#@heading.Id">@heading.Text</a>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-9">
            @if (Model.Page is null)
            {
                <div class="card">
                    <div class="card-body empty-state">
                        @Lang.T("Halaman dokumentasi tidak ditemukan.", "Documentation page not found.") <a href="@DocUrl("")">@Lang.T("Kembali ke daftar isi", "Back to the contents")</a>.
                    </div>
                </div>
            }
            else
            {
                <article class="card">
                    <div class="card-body docs-body">
                        @Html.Raw(Model.Page.Html)
                    </div>
                    @if (Model.Page.Previous is not null || Model.Page.Next is not null)
                    {
                        <div class="card-footer d-flex justify-content-between gap-2">
                            <div>
                                @if (Model.Page.Previous is { } previous)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@DocUrl(previous.Slug)">← @previous.Title</a>
                                }
                            </div>
                            <div>
                                @if (Model.Page.Next is { } next)
                                {
                                    <a class="btn btn-sm btn-outline-secondary" href="@DocUrl(next.Slug)">@next.Title →</a>
                                }
                            </div>
                        </div>
                    }
                </article>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        // Filters the document list by title.
        (() => {
            const input = document.getElementById('docsFilter');
            if (!input) return;
            input.addEventListener('input', () => {
                const query = input.value.trim().toLowerCase();
                document.querySelectorAll('#docsNav a').forEach(link => {
                    link.classList.toggle('d-none', query.length > 0 && !link.textContent.toLowerCase().includes(query));
                });
            });
        })();
    </script>
}
