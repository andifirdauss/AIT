@{
    ViewData["Title"] = "Setting";
}

<div class="page-header">
    <div>
        <h1>Setting</h1>
        <p class="page-subtitle">Koneksi 9router, perilaku proxy, dan pengarahan Claude Code ke AiThread.</p>
    </div>
</div>

<form id="settingForm" autocomplete="off">
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card mb-3">
                <div class="card-header">Koneksi 9router</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label small" for="routerUrl">Base URL</label>
                        <input type="url" class="form-control mono" id="routerUrl" placeholder="http://localhost:20128" required />
                        <div class="form-text">Endpoint 9router (dashboard default di port 20128). Akhiran <span class="mono">/v1</span> otomatis dibuang.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small" for="routerKey">API key</label>
                        <input type="password" class="form-control mono" id="routerKey" placeholder="Kosongkan untuk mempertahankan key tersimpan" />
                        <div class="form-text" id="routerKeyHint"></div>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="routerKeyClear" />
                        <label class="form-check-label small" for="routerKeyClear">Hapus API key tersimpan</label>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnTestRouter">Test koneksi</button>
                        <span class="small" id="routerTestResult"></span>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header">Proxy & orkestrasi</div>
                <div class="card-body">
                    <div class="form-check form-switch mb-2">
                        <input class="form-check-input" type="checkbox" id="orchestrationEnabled" />
                        <label class="form-check-label" for="orchestrationEnabled">Orkestrasi aktif (planner → executor → wrapper)</label>
                        <div class="form-text">Jika mati, AiThread hanya meneruskan request Claude Code ke 9router.</div>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="streamProgress" />
                        <label class="form-check-label" for="streamProgress">Tampilkan progres (rencana, tugas, tool planner) di Claude Code</label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small" for="passthroughModel">Model passthrough</label>
                        <select class="form-select" id="passthroughModel"></select>
                        <div class="form-text">Untuk request pendukung Claude Code (judul sesi, compact, dsb.) yang tidak diorkestrasi.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small" for="proxyKey">Proxy API key (ANTHROPIC_AUTH_TOKEN)</label>
                        <div class="input-group">
                            <input type="text" class="form-control mono" id="proxyKey" placeholder="Kosong = terima semua request lokal" />
                            <button type="button" class="btn btn-outline-secondary" id="btnGenerateKey">Generate</button>
                        </div>
                    </div>

                    <div class="row g-2">
                        <div class="col-6 col-md-3">
                            <label class="form-label small" for="plannerMaxSteps">Langkah planner</label>
                            <input type="number" class="form-control" id="plannerMaxSteps" min="3" max="100" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small" for="executorMaxRetries">Retry executor</label>
                            <input type="number" class="form-control" id="executorMaxRetries" min="0" max="5" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small" for="maxParallelTasks">Maks paralel</label>
                            <input type="number" class="form-control" id="maxParallelTasks" min="1" max="64" required />
                        </div>
                        <div class="col-6 col-md-3">
                            <label class="form-label small" for="requestTimeout">Timeout (detik)</label>
                            <input type="number" class="form-control" id="requestTimeout" min="30" max="3600" required />
                        </div>
                    </div>
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">Simpan setting</button>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card">
                <div class="card-header">Integrasi Claude Code</div>
                <div class="card-body">
                    <p class="small text-secondary">AiThread memanfaatkan blok <span class="mono">env</span> di <span class="mono">settings.json</span> Claude Code agar semua prompt diarahkan ke proxy ini. Pilih cakupan:</p>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="claudeScope" id="scopeProject" value="Project" checked />
                            <label class="form-check-label" for="scopeProject">Per project — <span class="mono">&lt;project&gt;/.claude/settings.local.json</span> (disarankan)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="claudeScope" id="scopeUser" value="User" />
                            <label class="form-check-label" for="scopeUser">Global — <span class="mono">~/.claude/settings.json</span> (semua sesi Claude Code)</label>
                        </div>
                    </div>
                    <div class="mb-3" id="claudeProjectGroup">
                        <label class="form-label small" for="claudeProject">Project</label>
                        <select class="form-select" id="claudeProject"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small" for="proxyUrl">URL proxy AiThread</label>
                        <input type="url" class="form-control mono" id="proxyUrl" />
                        <div class="form-text">Gunakan alamat HTTP — Claude Code (Node) tidak mempercayai sertifikat development ASP.NET.</div>
                    </div>

                    <div class="alert small" id="claudeStatus">Memuat status…</div>

                    <label class="form-label small">Blok yang akan ditulis</label>
                    <pre class="code-block mb-3" id="claudePreview"></pre>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-primary" id="btnApplyClaude">Terapkan ke Claude Code</button>
                        <button type="button" class="btn btn-outline-danger" id="btnRevertClaude">Kembalikan</button>
                    </div>
                    <p class="small text-secondary mt-3 mb-0">
                        Backup file asli disimpan sekali sebagai <span class="mono">*.aithread-backup</span>. Buka sesi Claude Code baru setelah menerapkan.
                        Cakupan per project juga mengirim header <span class="mono">X-AiThread-Solution</span> sehingga sesi selalu terikat ke solution yang benar.
                    </p>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script src="~/js/pages/settings.js" asp-append-version="true"></script>
}
